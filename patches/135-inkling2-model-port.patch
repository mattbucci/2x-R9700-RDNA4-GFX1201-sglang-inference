@@ -0,0 +1,837 @@
+"""Inkling 2 (Thinking Machines) on RDNA4.
+
+A port of the looped Inkling 2 architecture onto the v0.5.23 serving stack, written
+against the transformers reference (models/inkling2_loop) rather than the upstream
+SGLang model, whose attention, norms and expert GEMMs are FA4 / CuTe / Marlin only.
+
+- Attention runs on the Triton backend: the hidden-state-conditioned relative bias is
+  a score_mod over an aux tensor ``rel_logits[t, h, d]`` (0 <= d < rel_extent), the
+  per-token sinks ride the per-token sink path of the extend/decode kernels.
+- Short convolutions use the v1 Inkling conv-state pool through the Inkling 2
+  ShortConvolution (static, or dynamic per-token taps on the global layers).
+- Each extra pass of the loop core keeps its own KV and conv-state layers
+  (Inkling2ModelConfig.cache_layer_id / conv_layer_id).
+- Routed experts stay packed (NVFP4 on layers 0-19, MXFP8 on 20-23) and are
+  dequantized in the fused Triton expert kernels with BF16 activations (the transformers
+  path; SGLANG_INKLING2_ACT_QUANT=1 fake-quantizes them like the upstream Hopper path).
+  Experts are tensor-parallel over the intermediate width.
+- Decode-sized steps run fused Triton kernels for the attention residuals, loop message
+  gates, attention prologue, router and the multi-input projection GEMV.
+"""
+
+import logging
+import os
+from array import array
+from typing import Iterable, Optional, Set, Tuple
+
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+from sglang.kernels.ops.attention.score_mod import relative_bias_score_mod
+from sglang.kernels.ops.attention.inkling2_attn_res_rdna4 import attn_res as _attn_res_triton
+from sglang.kernels.ops.elementwise.inkling2_message_gate_rdna4 import message_gates as _message_gates_triton
+from sglang.kernels.ops.attention.inkling2_prologue_rdna4 import attention_prologue as _prologue_triton
+from sglang.kernels.ops.attention.inkling2_prologue_rdna4 import route as _route_triton
+from sglang.kernels.ops.gemm.inkling2_gemv_rdna4 import seg_gemv as _seg_gemv
+from sglang.kernels.ops.moe.inkling2_moe_rdna4 import inkling2_routed_experts
+from sglang.srt.configs.inkling2 import Inkling2MMConfig, Inkling2ModelConfig
+from sglang.srt.distributed.communication_op import tensor_model_parallel_all_reduce
+from sglang.srt.distributed.parallel_state import (
+    get_tensor_model_parallel_rank,
+    get_tensor_model_parallel_world_size,
+)
+from sglang.srt.layers.linear import ColumnParallelLinear, RowParallelLinear
+from sglang.srt.layers.logits_processor import LogitsProcessor
+from sglang.srt.layers.quantization.inkling2 import Inkling2QuantConfig
+from sglang.srt.layers.radix_attention import RadixAttention
+from sglang.srt.layers.vocab_parallel_embedding import (
+    ParallelLMHead,
+    VocabParallelEmbedding,
+)
+from sglang.srt.managers.mm_utils import general_mm_embed_routine, pad_mm_tokens
+from sglang.srt.managers.schedule_batch import MultimodalDataItem, MultimodalInputs
+from sglang.srt.model_executor.forward_batch_info import ForwardBatch
+from sglang.srt.model_loader.weight_utils import default_weight_loader
+from sglang.srt.models.inkling_common.inkling2_sconv import ShortConvolution
+from sglang.srt.models.inkling_common.sconv import SconvType
+from sglang.srt.multimodal.modality import Modality
+from sglang.srt.utils import add_prefix
+
+logger = logging.getLogger(__name__)
+
+# Debug: dump per-layer-visit hidden states of the first forward to this directory.
+_DUMP_DIR = os.environ.get("SGLANG_INKLING2_DUMP_DIR", "")
+# ... of the first forward with exactly this many tokens (0 = the first forward).
+_DUMP_TOKENS = int(os.environ.get("SGLANG_INKLING2_DUMP_TOKENS", "0"))
+# Expert activations: BF16 by default (the transformers reference path, served by the fused
+# Triton kernel); 1 = fake-quantize to the checkpoint's activation format like upstream's
+# Hopper path (torch, per-rank amax under TP, slow; for quality A/Bs).
+_ACT_QUANT = os.environ.get("SGLANG_INKLING2_ACT_QUANT", "0") == "1"
+
+_E2M1 = (0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0, -0.0, -0.5, -1.0, -1.5, -2.0, -3.0, -4.0, -6.0)
+
+
+def _softcap(x: torch.Tensor, cap: float) -> torch.Tensor:
+    return torch.tanh(x / cap) * cap
+
+
+_COMPILE = os.environ.get("SGLANG_INKLING2_COMPILE", "1") == "1"
+if _COMPILE:
+    import torch._dynamo
+
+    # One graph per (block count, query count, decode/prefill) variant of the helpers.
+    torch._dynamo.config.cache_size_limit = max(torch._dynamo.config.cache_size_limit, 128)
+    torch._dynamo.config.accumulated_cache_size_limit = max(
+        torch._dynamo.config.accumulated_cache_size_limit, 1024
+    )
+
+
+def _compiled(fn):
+    """Fuse a chain of small FP32 ops into Inductor Triton kernels (dynamic token count)."""
+    return torch.compile(fn, dynamic=True, fullgraph=True) if _COMPILE else fn
+
+
+@_compiled
+def _rms_norm_fn(x, weight, eps: float):
+    x = x.float()
+    return (weight.float() * (x * torch.rsqrt(x.square().mean(-1, keepdim=True) + eps))).to(torch.bfloat16)
+
+
+@_compiled
+def _rms_norm_stack_fn(x, weights, eps: float):
+    """x: [3, T, H] streams (k, v, q order); weights: [3, H]. BF16 [3, T, H]."""
+    x = x.float()
+    return (weights.float()[:, None, :] * (x * torch.rsqrt(x.square().mean(-1, keepdim=True) + eps))).to(torch.bfloat16)
+
+
+# Token counts up to this run the projections as GEMVs (one launch for every segment).
+_GEMV_MAX_TOKENS = int(os.environ.get("SGLANG_INKLING2_GEMV_MAX_TOKENS", "4"))
+
+
+@_compiled
+def _kv_post_fn(k, v, qk_threshold: float, eps: float):
+    k = k.float()
+    k = k * (qk_threshold / (torch.linalg.vector_norm(k, dim=-1, keepdim=True) + 1e-6)).clamp(max=1.0)
+    v = v.float()
+    v = v * torch.rsqrt(v.square().mean(-1, keepdim=True) + eps)
+    return k.to(torch.bfloat16), v.to(torch.bfloat16)
+
+
+@_compiled
+def _gate_out_fn(out, gate):
+    return (out.float() * torch.sigmoid(gate.float())).to(torch.bfloat16)
+
+
+@_compiled
+def _add_fn(a, b):
+    return a.float() + b.float()
+
+
+@_compiled
+def _add_bf16_fn(a, b):
+    return (a.float() + b.float()).to(torch.bfloat16)
+
+
+def _e2m1_round(x: torch.Tensor) -> torch.Tensor:
+    a = x.abs()
+    r = torch.where(
+        a <= 0.25, 0.0, torch.where(a < 0.75, 0.5, torch.where(a <= 1.25, 1.0, torch.where(
+            a < 1.75, 1.5, torch.where(a <= 2.5, 2.0, torch.where(a < 3.5, 3.0, torch.where(
+                a <= 5.0, 4.0, 6.0)))))))
+    return torch.where(x < 0, -r, r)
+
+
+def nvfp4_fake_quant(x: torch.Tensor) -> torch.Tensor:
+    """Rows of x as NVFP4 values (fouroversix_mae block choice) times the per-row outer
+    scale, as upstream's Hopper _nvfp4_values computes them."""
+    x = x.float()
+    rows, k = x.shape
+    amax = x.abs().amax(-1, keepdim=True)
+    enc = torch.clamp(1536.0 / amax, max=3.4028234663852886e38)
+    dec = 1.0 / enc
+    outer = amax / 1536.0
+    xb = x.view(rows, k // 16, 16)
+    bmax = xb.abs().amax(-1)
+    s6 = torch.clamp(bmax * (enc * (1 / 6.0)), max=448.0).to(torch.float8_e4m3fn).float()
+    s4 = torch.clamp(bmax * (enc * 0.25), max=448.0).to(torch.float8_e4m3fn).float()
+    inv6 = torch.clamp(1.0 / (s6 * dec), max=3.4028234663852886e38)
+    inv4 = torch.clamp(1.0 / (s4 * dec), max=3.4028234663852886e38)
+    r6 = _e2m1_round(xb * inv6[..., None]) * s6[..., None]
+    r4 = _e2m1_round(xb * inv4[..., None]) * s4[..., None]
+    o = outer[..., None]
+    err6 = (r6 * o - xb).abs().sum(-1)
+    err4 = (r4 * o - xb).abs().sum(-1)
+    vals = torch.where((err4 < err6)[..., None], r4, r6)
+    return torch.nan_to_num(vals * o).view(rows, k)
+
+
+def mxfp8_fake_quant(x: torch.Tensor) -> torch.Tensor:
+    x = x.float()
+    rows, k = x.shape
+    xb = x.view(rows, k // 32, 32)
+    bmax = xb.abs().amax(-1, keepdim=True).clamp(min=2.0**-127)
+    scale = torch.exp2(torch.floor(torch.log2(bmax)) - 8)
+    v = (xb / scale).clamp(-448, 448).to(torch.float8_e4m3fn).float()
+    return (v * scale).view(rows, k)
+
+
+# ---------------------------------------------------------------------------
+# Attention residuals and loop message gates
+# ---------------------------------------------------------------------------
+
+
+class BlockAttentionResidual(nn.Module):
+    """Softmax over the block states plus the partial state, with learned queries;
+    keys and values are the unweighted-RMS-normed states (FP32)."""
+
+    def __init__(self, hidden_size: int, num_queries: int = 1, eps: float = 1e-6):
+        super().__init__()
+        self.num_queries = num_queries
+        self.eps = eps
+        shape = (hidden_size,) if num_queries == 1 else (num_queries, hidden_size)
+        self.query = nn.Parameter(torch.zeros(*shape, dtype=torch.float32), requires_grad=False)
+
+    def forward(self, block_states: list, partial: torch.Tensor) -> torch.Tensor:
+        """FP32 [T, num_queries, H]."""
+        return _attn_res_triton([*block_states, partial], self.query, self.eps)
+
+
+class MessageGate(nn.Module):
+    """(1 - tanh(forget)) * hidden + tanh(gain) * message, from a rank-64 controller
+    (weights only; the fused message_gates kernel runs it)."""
+
+    def __init__(self, hidden_size: int, rank: int, eps: float):
+        super().__init__()
+        self.eps = eps
+        self.down_weight = nn.Parameter(torch.empty(rank, 2 * hidden_size), requires_grad=False)
+        self.forget_weight = nn.Parameter(torch.empty(hidden_size, rank), requires_grad=False)
+        self.gain_weight = nn.Parameter(torch.empty(hidden_size, rank), requires_grad=False)
+
+    def finalize(self):
+        # forget and gain projections as one [2H, rank] BF16 matrix.
+        self.fg_weight = torch.cat([self.forget_weight, self.gain_weight], 0).contiguous()
+
+class RMSNorm(nn.Module):
+    def __init__(self, hidden_size: int, eps: float):
+        super().__init__()
+        self.eps = eps
+        self.weight = nn.Parameter(torch.ones(hidden_size), requires_grad=False)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return _rms_norm_fn(x, self.weight, self.eps)
+
+
+# ---------------------------------------------------------------------------
+# Attention
+# ---------------------------------------------------------------------------
+
+
+def _shard_rows(param: nn.Parameter, loaded: torch.Tensor, dim: int = 0):
+    if loaded.shape[dim] != param.shape[dim]:
+        size = param.shape[dim]
+        loaded = loaded.narrow(dim, get_tensor_model_parallel_rank() * size, size)
+    assert loaded.shape == param.shape, (loaded.shape, param.shape)
+    param.data.copy_(loaded)
+
+
+class Inkling2Attention(nn.Module):
+    def __init__(self, config: Inkling2ModelConfig, layer_id: int, prefix: str = ""):
+        super().__init__()
+        tp = get_tensor_model_parallel_world_size()
+        self.config = config
+        self.layer_id = layer_id
+        self.is_local = layer_id in config.local_layer_ids
+        hidden = config.hidden_size
+        if self.is_local:
+            heads, kv_heads, head_dim = (
+                config.swa_num_attention_heads, config.swa_num_key_value_heads, config.swa_head_dim)
+        else:
+            heads, kv_heads, head_dim = (
+                config.num_attention_heads, config.num_key_value_heads, config.head_dim)
+        assert heads % tp == 0 and kv_heads % tp == 0
+        self.heads, self.kv_heads, self.head_dim = heads // tp, kv_heads // tp, head_dim
+        self.d_rel = config.d_rel
+        self.rel_extent = config.sliding_window_size if self.is_local else config.rel_extent
+        self.eps = config.rms_norm_eps
+        self.qk_threshold = config.qk_l2_clip_threshold
+        self.rel_threshold = config.rel_l2_clip_threshold
+        self.log_alpha = config.log_scaling_alpha
+        self.log_floor = float(config.log_scaling_n_floor)
+
+        self.wq_du = ColumnParallelLinear(hidden, heads * head_dim, bias=False, prefix=add_prefix("wq_du", prefix))
+        self.wk_dv = ColumnParallelLinear(hidden, kv_heads * head_dim, bias=False, prefix=add_prefix("wk_dv", prefix))
+        self.wv_dv = ColumnParallelLinear(hidden, kv_heads * head_dim, bias=False, prefix=add_prefix("wv_dv", prefix))
+        self.wr_du = ColumnParallelLinear(hidden, heads * self.d_rel, bias=False, prefix=add_prefix("wr_du", prefix))
+        self.gate_attn = ColumnParallelLinear(hidden, heads * head_dim, bias=False, prefix=add_prefix("gate_attn", prefix))
+        self.attn_sink_proj = ColumnParallelLinear(hidden, heads, bias=False, prefix=add_prefix("attn_sink_proj", prefix))
+        self.wo_ud = RowParallelLinear(heads * head_dim, hidden, bias=False, reduce_results=True, prefix=add_prefix("wo_ud", prefix))
+
+        self.q_scale = nn.Parameter(torch.ones(self.heads, head_dim), requires_grad=False)
+        self.rel_scale = nn.Parameter(torch.ones(self.heads, self.d_rel), requires_grad=False)
+        self.rel_proj = nn.Parameter(torch.empty(self.d_rel, self.rel_extent), requires_grad=False)
+        for p in (self.q_scale, self.rel_scale):
+            p.weight_loader = _shard_rows
+        self.rel_proj.weight_loader = default_weight_loader
+
+        kv_dim = self.kv_heads * head_dim
+        sconv_kw = dict(kernel_size=config.sconv_kernel_size, layer_id=layer_id)
+        if self.is_local:
+            self.k_sconv = ShortConvolution(kv_dim, sconv_type=SconvType.K_LOCAL, **sconv_kw)
+            self.v_sconv = ShortConvolution(kv_dim, sconv_type=SconvType.V_LOCAL, **sconv_kw)
+        else:
+            dyn = dict(is_dynamic=True, dynamic_input_size=hidden, n_heads=self.kv_heads)
+            self.k_sconv = ShortConvolution(kv_dim, sconv_type=SconvType.K_FULL, **sconv_kw, **dyn)
+            self.v_sconv = ShortConvolution(kv_dim, sconv_type=SconvType.V_FULL, **sconv_kw, **dyn)
+
+        passes = [0]
+        if config.loop_config is not None and layer_id in config.loop_core_layers:
+            passes = list(range(config.loop_config["num_passes"]))
+        self.cache_ids = [config.cache_layer_id(layer_id, p) for p in passes]
+        self.conv_ids = [config.conv_layer_id(layer_id, p) for p in passes]
+        self.attn = nn.ModuleList(
+            RadixAttention(
+                self.heads,
+                head_dim,
+                head_dim**-0.5,
+                num_kv_heads=self.kv_heads,
+                layer_id=cid,
+                sliding_window_size=(config.sliding_window_size - 1) if self.is_local else -1,
+                prefix=add_prefix(f"attn.{i}", prefix),
+            )
+            for i, cid in enumerate(self.cache_ids)
+        )
+
+    def finalize(self):
+        """One weight for every projection of the attention input, sliced as needed:
+        rows [k | v | q | rel | gate | sink] (this rank's heads); k and v first so the
+        segment boundaries of the multi-input GEMV are tile aligned."""
+        parts = [self.wk_dv.weight, self.wv_dv.weight, self.wq_du.weight, self.wr_du.weight,
+                 self.gate_attn.weight, self.attn_sink_proj.weight]
+        merged = torch.cat([p.data for p in parts], 0).contiguous()
+        sizes = [p.shape[0] for p in parts]
+        offs = [0]
+        for n in sizes:
+            offs.append(offs[-1] + n)
+        for p, a, b in zip(parts, offs, offs[1:]):
+            p.data = merged[a:b]
+        self.w_all = merged
+        self.kv_dim = sizes[0]
+        self.split_qrgs = sizes[2:]
+
+    def _sconv(self, module: ShortConvolution, x, positions, forward_batch, pass_idx, dynamic_input=None):
+        with module.state_layer_override(self.conv_ids[pass_idx]):
+            return module(x, positions, forward_batch, dynamic_input=dynamic_input)
+
+    def forward(self, x, positions, forward_batch: ForwardBatch, pass_idx: int):
+        """x: normed BF16 attention input, [T, H] shared by k, v and q, or [3, T, H] in
+        k, v, q order."""
+        kv = self.kv_dim
+        T = x.shape[-2]
+        if T <= _GEMV_MAX_TOKENS:
+            proj = _seg_gemv(x, self.w_all, [kv, 2 * kv])
+        elif x.dim() == 2:
+            proj = F.linear(x, self.w_all)
+        else:
+            proj = torch.cat(
+                [F.linear(x[0], self.w_all[:kv]), F.linear(x[1], self.w_all[kv : 2 * kv]),
+                 F.linear(x[2], self.w_all[2 * kv :])], dim=-1)
+        k, v, qrgs = proj[:, :kv], proj[:, kv : 2 * kv], proj[:, 2 * kv :]
+        k_in = x if x.dim() == 2 else x[0]
+        v_in = x if x.dim() == 2 else x[1]
+        nq, nr, ng, _ = self.split_qrgs
+        gate = qrgs[:, nq + nr : nq + nr + ng]
+        q, rel_logits, sinks = _prologue_triton(
+            qrgs, 0, nq, nq + nr + ng, self.heads, self.head_dim, self.d_rel, self.q_scale,
+            self.rel_scale, self.rel_proj, positions, self.qk_threshold, self.rel_threshold,
+            self.log_alpha, self.log_floor, not self.is_local,
+        )
+
+        dyn_k = k_in if not self.is_local else None
+        dyn_v = v_in if not self.is_local else None
+        # short_convolution takes a row stride: the projection slices need no copy.
+        k = self._sconv(self.k_sconv, k, positions, forward_batch, pass_idx, dyn_k)
+        v = self._sconv(self.v_sconv, v, positions, forward_batch, pass_idx, dyn_v)
+        k, v = _kv_post_fn(
+            k.view(T, self.kv_heads, self.head_dim), v.view(T, self.kv_heads, self.head_dim), self.qk_threshold, self.eps
+        )
+
+        out = self.attn[pass_idx](
+            q.reshape(T, -1),
+            k.reshape(T, -1),
+            v.reshape(T, -1),
+            forward_batch,
+            sinks=sinks,
+            score_mod=relative_bias_score_mod,
+            aux_tensors=[rel_logits],
+        )
+        out = _gate_out_fn(out.view(T, -1), gate)
+        if T <= _GEMV_MAX_TOKENS:
+            out = _seg_gemv(out, self.wo_ud.weight, [])
+            return tensor_model_parallel_all_reduce(out) if get_tensor_model_parallel_world_size() > 1 else out
+        return self.wo_ud(out)[0]
+
+
+# ---------------------------------------------------------------------------
+# Routed experts
+# ---------------------------------------------------------------------------
+
+
+class Inkling2Experts(nn.Module):
+    """Packed routed experts, tensor-parallel over the intermediate width.
+
+    w13 rows interleave gate and up (row 2i gate, 2i + 1 up), so a contiguous row
+    range holds a contiguous intermediate slice. NVFP4: two e2m1 codes per byte (even
+    element low), e4m3 scale per 16, expert factor amax / outer_scale_denominator.
+    MXFP8: e4m3 values, ue8m0 scale per 32.
+    """
+
+    def __init__(self, config: Inkling2ModelConfig, layer_id: int, nvfp4: bool):
+        super().__init__()
+        tp = get_tensor_model_parallel_world_size()
+        self.nvfp4 = nvfp4
+        E, H, inter = config.n_routed_experts, config.hidden_size, config.intermediate_size
+        assert inter % tp == 0
+        self.inter = inter // tp
+        self.gate_cap, self.up_cap = config.mlp_gate_softcap, config.mlp_up_softcap
+        rows13 = 2 * self.inter
+        if nvfp4:
+            assert self.inter % 16 == 0
+            self.w13_weight = nn.Parameter(torch.empty(E, rows13, H // 2, dtype=torch.uint8), requires_grad=False)
+            self.w13_weight_scale = nn.Parameter(torch.empty(E, rows13, H // 16, dtype=torch.float8_e4m3fn), requires_grad=False)
+            self.w2_weight = nn.Parameter(torch.empty(E, H, self.inter // 2, dtype=torch.uint8), requires_grad=False)
+            self.w2_weight_scale = nn.Parameter(torch.empty(E, H, self.inter // 16, dtype=torch.float8_e4m3fn), requires_grad=False)
+            self.w13_weight_amax = nn.Parameter(torch.empty(E, dtype=torch.float32), requires_grad=False)
+            self.w2_weight_amax = nn.Parameter(torch.empty(E, dtype=torch.float32), requires_grad=False)
+            self.w13_weight_outer_scale_denominator = nn.Parameter(torch.empty(1, dtype=torch.float32), requires_grad=False)
+            self.w2_weight_outer_scale_denominator = nn.Parameter(torch.empty(1, dtype=torch.float32), requires_grad=False)
+        else:
+            assert self.inter % 32 == 0
+            self.w13_weight = nn.Parameter(torch.empty(E, rows13, H, dtype=torch.float8_e4m3fn), requires_grad=False)
+            self.w13_weight_scale = nn.Parameter(torch.empty(E, rows13, H // 32, dtype=torch.uint8), requires_grad=False)
+            self.w2_weight = nn.Parameter(torch.empty(E, H, self.inter, dtype=torch.float8_e4m3fn), requires_grad=False)
+            self.w2_weight_scale = nn.Parameter(torch.empty(E, H, self.inter // 32, dtype=torch.uint8), requires_grad=False)
+        for name, p in self.named_parameters():
+            p.weight_loader = self._loader(name)
+        self.register_buffer("e2m1", torch.tensor(_E2M1, dtype=torch.float32), persistent=False)
+
+    def _loader(self, name: str):
+        rank = get_tensor_model_parallel_rank()
+
+        def load(param, loaded):
+            if name.startswith("w13_weight") and loaded.dim() == 3:
+                rows = param.shape[1]
+                loaded = loaded.narrow(1, rank * rows, rows)
+            elif name.startswith("w2_weight") and loaded.dim() == 3:
+                cols = param.shape[2]
+                loaded = loaded.narrow(2, rank * cols, cols)
+            assert loaded.shape == param.shape, (name, loaded.shape, param.shape)
+            param.data.copy_(loaded.view(param.dtype) if loaded.dtype != param.dtype and loaded.element_size() == param.element_size() else loaded)
+
+        return load
+
+    def _dequant(self, which: str, e: int) -> torch.Tensor:
+        w = getattr(self, f"{which}_weight")[e]
+        s = getattr(self, f"{which}_weight_scale")[e]
+        if self.nvfp4:
+            codes = w.long()
+            vals = torch.stack((self.e2m1[codes & 0xF], self.e2m1[codes >> 4]), -1)
+            vals = vals.view(w.shape[0], -1, 16) * s.float()[..., None]
+            factor = getattr(self, f"{which}_weight_amax")[e] / getattr(self, f"{which}_weight_outer_scale_denominator")[0]
+            return vals.reshape(w.shape[0], -1) * factor
+        vals = w.float().view(*s.shape, 32) * torch.exp2(s.float() - 127)[..., None]
+        return vals.reshape(w.shape[0], -1)
+
+    def _factors(self):
+        if not hasattr(self, "_w13_factor"):
+            if self.nvfp4:
+                self._w13_factor = (self.w13_weight_amax / self.w13_weight_outer_scale_denominator).float().contiguous()
+                self._w2_factor = (self.w2_weight_amax / self.w2_weight_outer_scale_denominator).float().contiguous()
+            else:
+                self._w13_factor = self._w2_factor = None
+        return self._w13_factor, self._w2_factor
+
+    def forward(self, x: torch.Tensor, topk_ids: torch.Tensor, topk_weights: torch.Tensor) -> torch.Tensor:
+        """Partial (this rank's intermediate slice) sum over the top-k experts, FP32."""
+        if not _ACT_QUANT:
+            f13, f2 = self._factors()
+            return inkling2_routed_experts(
+                x, topk_ids.to(torch.int32), topk_weights,
+                self.w13_weight, self.w13_weight_scale, self.w2_weight, self.w2_weight_scale, f13, f2,
+                nvfp4=self.nvfp4, gate_cap=self.gate_cap, up_cap=self.up_cap,
+            )
+        fq = (nvfp4_fake_quant if self.nvfp4 else mxfp8_fake_quant) if _ACT_QUANT else (
+            lambda t: t.to(torch.bfloat16).float())
+        out = torch.zeros(x.shape, dtype=torch.float32, device=x.device)
+        x_q = fq(x)
+        for e in topk_ids.unique().tolist():
+            tok, pos = torch.where(topk_ids == e)
+            gate_up = x_q[tok] @ self._dequant("w13", e).t()
+            gate, up = gate_up[:, 0::2], gate_up[:, 1::2]
+            h = (_softcap(gate, self.gate_cap) * torch.sigmoid(gate) * _softcap(up, self.up_cap))
+            h = fq(h.to(torch.bfloat16).float())
+            y = h @ self._dequant("w2", e).t()
+            out.index_add_(0, tok, y * topk_weights[tok, pos, None].float())
+        return out
+
+
+class Inkling2MoE(nn.Module):
+    def __init__(self, config: Inkling2ModelConfig, layer_id: int, nvfp4: bool):
+        super().__init__()
+        self.top_k = config.num_experts_per_tok
+        self.route_scale = config.route_scale
+        E, H = config.n_routed_experts, config.hidden_size
+        self.gate_weight = nn.Parameter(torch.empty(E, H, dtype=torch.bfloat16), requires_grad=False)
+        self.gate_bias = nn.Parameter(torch.zeros(E, dtype=torch.float32), requires_grad=False)
+        self.experts = Inkling2Experts(config, layer_id, nvfp4)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        ids, weights = _route_triton(x, self.gate_weight, self.gate_bias, self.top_k, self.route_scale)
+        out = self.experts(x, ids, weights)
+        if get_tensor_model_parallel_world_size() > 1:
+            out = tensor_model_parallel_all_reduce(out)
+        return out.to(torch.bfloat16)
+
+
+# ---------------------------------------------------------------------------
+# Decoder layer
+# ---------------------------------------------------------------------------
+
+
+class Inkling2DecoderLayer(nn.Module):
+    def __init__(self, config: Inkling2ModelConfig, layer_id: int, quant: Inkling2QuantConfig, prefix: str = ""):
+        super().__init__()
+        H, eps = config.hidden_size, config.rms_norm_eps
+        self.layer_id = layer_id
+        self.is_local = layer_id in config.local_layer_ids
+        self.is_block_boundary = layer_id % config.n_layers_per_attn_res_block == 0
+        self.is_loop = config.loop_config is not None and layer_id in config.loop_core_layers
+        self.attention_input = (
+            BlockAttentionResidual(H, 1 if self.is_local else 3) if layer_id > 0 else None
+        )
+        self.mlp_input = BlockAttentionResidual(H, 1)
+        self.attn = Inkling2Attention(config, layer_id, prefix=add_prefix("attn", prefix))
+        if self.is_local:
+            self.attn_norm = RMSNorm(H, eps)
+        else:
+            self.q_input_norm = RMSNorm(H, eps)
+            self.k_input_norm = RMSNorm(H, eps)
+            self.v_input_norm = RMSNorm(H, eps)
+        self.mlp_norm = RMSNorm(H, eps)
+        nvfp4 = f"model.llm.layers.{layer_id}.mlp.experts.w13_weight" in quant.nvfp4_weights
+        self.mlp = Inkling2MoE(config, layer_id, nvfp4)
+        kw = dict(kernel_size=config.sconv_kernel_size, layer_id=layer_id, tp_rank=0, tp_size=1)
+        self.attn_sconv = ShortConvolution(H, sconv_type=SconvType.ATTN, **kw)
+        self.mlp_sconv = ShortConvolution(H, sconv_type=SconvType.MLP, **kw)
+        if self.is_loop:
+            rank = config.loop_config["gate_rank"]
+            self.controllers = nn.ModuleDict({k: MessageGate(H, rank, eps) for k in ("attn", "k", "v", "mlp")})
+
+    def _conv(self, module, x, positions, forward_batch, pass_idx):
+        with module.state_layer_override(self.attn.conv_ids[pass_idx]):
+            return module(x.contiguous(), positions, forward_batch)
+
+    def forward(self, hidden, block_states, positions, forward_batch, *, pass_idx=0, messages=None):
+        block_residual = hidden
+        eps = self.mlp_norm.eps
+        ar = None if self.attention_input is None else self.attention_input(block_states, hidden)
+        if messages is not None:
+            head = self.controllers["attn"]
+            gate_in = ar[:, 0] if self.is_local else ar
+            gated = _message_gates_triton(gate_in, messages, head._down_stack, head._fg_stack, eps)
+            streams = [gated[0], gated[1], gated[2]]
+        elif ar is None:
+            streams = [hidden] * 3
+        elif self.is_local:
+            streams = [ar[:, 0]] * 3
+        else:
+            streams = [ar[:, 0], ar[:, 1], ar[:, 2]]
+        if self.is_local and streams[0] is streams[1] and streams[1] is streams[2]:
+            x = self.attn_norm(streams[0])
+        else:
+            # k, v, q order for the merged projection
+            x = _rms_norm_stack_fn(torch.stack([streams[1], streams[2], streams[0]]), self._norm_stack, eps)
+
+        attn_out = self.attn(x, positions, forward_batch, pass_idx)
+        attn_out = self._conv(self.attn_sconv, attn_out, positions, forward_batch, pass_idx)
+
+        local_blocks = block_states
+        if self.is_block_boundary:
+            residual = attn_out.float()
+            local_blocks = [*block_states, block_residual]
+        else:
+            residual = _add_fn(block_residual, attn_out)
+        mlp_in = self.mlp_input(local_blocks, residual)[:, 0]
+        if messages is not None:
+            g = self.controllers["mlp"]
+            mlp_in = _message_gates_triton(mlp_in, messages[:, 3:], g._down_1, g._fg_1, eps)[0]
+        mlp_out = self.mlp(self.mlp_norm(mlp_in))
+        mlp_out = self._conv(self.mlp_sconv, mlp_out, positions, forward_batch, pass_idx)
+        return _add_bf16_fn(residual, mlp_out)
+
+
+# ---------------------------------------------------------------------------
+# Language model
+# ---------------------------------------------------------------------------
+
+
+class _NormedEmbedding(nn.Module):
+    """Token embedding followed by embed_norm. Image features are scattered into the
+    embedding sequence after this, without the norm (as upstream does)."""
+
+    def __init__(self, embed: nn.Module, norm: nn.Module):
+        super().__init__()
+        self._modules_ref = (embed, norm)
+
+    @property
+    def weight(self):
+        return self._modules_ref[0].weight
+
+    @property
+    def num_embeddings(self):
+        return self._modules_ref[0].num_embeddings
+
+    def forward(self, input_ids: torch.Tensor) -> torch.Tensor:
+        embed, norm = self._modules_ref
+        return norm(embed(input_ids))
+
+
+class Inkling2LLM(nn.Module):
+    def __init__(self, config: Inkling2ModelConfig, quant: Inkling2QuantConfig, prefix: str = ""):
+        super().__init__()
+        self.config = config
+        H = config.hidden_size
+        self.embed = VocabParallelEmbedding(config.vocab_size, H, prefix=add_prefix("embed", prefix))
+        self.embed_norm = RMSNorm(H, config.rms_norm_eps)
+        self.layers = nn.ModuleList(
+            Inkling2DecoderLayer(config, i, quant, prefix=add_prefix(f"layers.{i}", prefix))
+            for i in range(config.num_hidden_layers)
+        )
+        self.norm = RMSNorm(H, config.rms_norm_eps)
+        self.output_query = BlockAttentionResidual(H, 1)
+        loop = config.loop_config
+        if loop is not None:
+            n = loop["core_end"] - loop["core_start"]
+            # middle_cycle_cross_pass_queries: [query, mlp] per loop layer;
+            # middle_cycle_cross_pass_kv_queries: [key, value] per loop layer.
+            self.cross_pass_queries = nn.Parameter(torch.zeros(2 * n, H, dtype=torch.float32), requires_grad=False)
+            self.cross_pass_kv_queries = nn.Parameter(torch.zeros(2 * n, H, dtype=torch.float32), requires_grad=False)
+        self.unembed = ParallelLMHead(config.vocab_size, H, prefix=add_prefix("unembed", prefix))
+        self.logits_processor = LogitsProcessor(config)
+        self._dumped = False
+
+    def get_input_embeddings(self):
+        if not hasattr(self, "_normed_embed"):
+            object.__setattr__(self, "_normed_embed", _NormedEmbedding(self.embed, self.embed_norm))
+        return self._normed_embed
+
+    def _messages(self, prev_blocks: list, prev_hidden: torch.Tensor, loop_idx: int) -> list:
+        """Query, key, value and MLP messages for loop layer loop_idx from the previous pass."""
+        q = self._message_queries[loop_idx]
+        return _attn_res_triton([*prev_blocks, prev_hidden], q, self.config.rms_norm_eps)  # [T, 4, H]
+
+    def _dump(self, tag, x, forward_batch):
+        if (
+            _DUMP_DIR
+            and not self._dumped
+            and get_tensor_model_parallel_rank() == 0
+            and (_DUMP_TOKENS == 0 or x.shape[0] == _DUMP_TOKENS)
+        ):
+            os.makedirs(_DUMP_DIR, exist_ok=True)
+            torch.save(x.detach().float().cpu(), os.path.join(_DUMP_DIR, f"{tag}.pt"))
+
+    def forward(self, input_ids, positions, forward_batch: ForwardBatch, input_embeds=None, **kwargs):
+        cfg = self.config
+        if input_embeds is None:
+            hidden = self.embed_norm(self.embed(input_ids))
+        else:
+            # From general_mm_embed_routine: normed token embeddings plus raw image features.
+            hidden = input_embeds.to(torch.bfloat16)
+        self._dump("embed", hidden, forward_batch)
+        blocks: list = []
+
+        def run(layer, hidden, blocks, pass_idx=0, messages=None):
+            new = layer(hidden, blocks, positions, forward_batch, pass_idx=pass_idx, messages=messages)
+            if layer.is_block_boundary:
+                blocks = [*blocks, hidden]
+            self._dump(f"layer{layer.layer_id:02d}_p{pass_idx}", new, forward_batch)
+            return new, blocks
+
+        loop = cfg.loop_config
+        start, end = (loop["core_start"], loop["core_end"]) if loop else (cfg.num_hidden_layers, cfg.num_hidden_layers)
+        for layer in self.layers[:start]:
+            hidden, blocks = run(layer, hidden, blocks)
+        if loop is not None:
+            pre_hidden, pre_blocks = hidden, blocks
+            n_pre = len(pre_blocks)
+            for layer in self.layers[start:end]:
+                hidden, blocks = run(layer, hidden, blocks)
+            for p in range(1, loop["num_passes"]):
+                prev_blocks, prev_hidden = blocks[n_pre + 1 :], hidden
+                hidden, blocks = pre_hidden, pre_blocks
+                for i, layer in enumerate(self.layers[start:end]):
+                    msgs = self._messages(prev_blocks, prev_hidden, i)
+                    hidden, blocks = run(layer, hidden, blocks, pass_idx=p, messages=msgs)
+            for layer in self.layers[end:]:
+                hidden, blocks = run(layer, hidden, blocks)
+        hidden = self.output_query(blocks, hidden)[:, 0]
+        hidden = self.norm(hidden)
+        self._dump("final", hidden, forward_batch)
+        if _DUMP_TOKENS == 0 or hidden.shape[0] == _DUMP_TOKENS:
+            self._dumped = True
+        return hidden
+
+
+class Inkling2ForConditionalGeneration(nn.Module):
+    fall_back_to_pt_during_load = False
+
+    def __init__(self, config: Inkling2MMConfig, quant_config=None, prefix: str = "") -> None:
+        super().__init__()
+        from sglang.srt.runtime_context import get_model
+
+        self.config = config
+        self.text_config = config.text_config
+        quant = quant_config if isinstance(quant_config, Inkling2QuantConfig) else None
+        if quant is None:
+            import json
+
+            with open(os.path.join(get_model().model_path, "hf_quant_config.json")) as f:
+                quant = Inkling2QuantConfig(json.load(f))
+        self.quant = quant
+        # Logits in FP32 when the checkpoint's unembed output precision asks for it.
+        self.text_config.enable_lm_head_output_fp32 = quant.unembed_output_dtype == torch.float32
+        self.llm = Inkling2LLM(self.text_config, quant, prefix=add_prefix("llm", prefix))
+        self.visual = None
+        from sglang.srt.runtime_context import get_mm
+
+        if get_mm().enable_multimodal and config.vision_config is not None:
+            from sglang.srt.models.inkling2_vision import Inkling2VisionEncoder
+
+            # Replicated on every rank (0.3B parameters).
+            self.visual = Inkling2VisionEncoder(config.vision_config, self.text_config.hidden_size)
+
+    @property
+    def model(self) -> nn.Module:
+        return self.llm
+
+    def get_input_embeddings(self) -> nn.Module:
+        return self.llm.get_input_embeddings()
+
+    def get_embed_and_head(self):
+        return self.llm.embed.weight, self.llm.unembed.weight
+
+    @property
+    def lm_head(self) -> nn.Module:
+        return self.llm.unembed
+
+    def pad_input_ids(self, input_ids: array, mm_inputs: MultimodalInputs) -> array:
+        return pad_mm_tokens(input_ids, mm_inputs)
+
+    def get_num_kv_cache_layers(self) -> int:
+        return self.text_config.num_attention_layers
+
+    def get_attention_sliding_window_size(self) -> Optional[int]:
+        return self.text_config.sliding_window_size - 1
+
+    def get_image_feature(self, items: list[MultimodalDataItem]) -> torch.Tensor:
+        if self.visual is None:
+            raise ValueError("Inkling2 image inputs require --enable-multimodal")
+        grids = torch.cat([item.model_specific_data["vision_grid_thw"] for item in items]).cpu()
+        param = next(self.visual.parameters())
+        patches = torch.cat([item.feature for item in items]).to(device=param.device, dtype=torch.bfloat16)
+        return self.visual(patches, grids)
+
+    @torch.no_grad()
+    def forward(self, input_ids: torch.Tensor, positions: torch.Tensor, forward_batch: ForwardBatch, **kwargs):
+        funcs = {Modality.IMAGE: self.get_image_feature} if self.visual is not None else {}
+        hidden = general_mm_embed_routine(
+            input_ids=input_ids,
+            forward_batch=forward_batch,
+            language_model=self.llm,
+            data_embedding_funcs=funcs,
+            positions=positions,
+        )
+        return self.llm.logits_processor(input_ids, hidden, self.llm.unembed, forward_batch)
+
+    # -- weights -------------------------------------------------------------
+
+    _RENAMES = (
+        ("attn.q_l2_clip.scale", "attn.q_scale"),
+        ("attn.rel_l2_clip.scale", "attn.rel_scale"),
+        ("attn.rel_logits_proj.proj", "attn.rel_proj"),
+        ("mlp.gate.weight", "mlp.gate_weight"),
+        ("mlp.gate.bias", "mlp.gate_bias"),
+    )
+
+    def load_weights(self, weights: Iterable[Tuple[str, torch.Tensor]]) -> Set[str]:
+        params = dict(self.named_parameters())
+        loaded: Set[str] = set()
+        cfg = self.text_config
+        for name, tensor in weights:
+            if name.startswith("model.visual."):
+                if self.visual is not None:
+                    n = name[len("model.") :]
+                    params[n].data.copy_(tensor)
+                    loaded.add(n)
+                continue
+            if not name.startswith("model.llm."):
+                continue
+            n = name[len("model.") :]
+            if n.startswith("llm.attn_res."):
+                rest = n[len("llm.attn_res.") :]
+                if rest == "output_query":
+                    n = "llm.output_query.query"
+                else:
+                    kind, idx = rest.split(".")
+                    layer = int(idx) + (1 if kind == "attn_queries" else 0)
+                    which = "attention_input" if kind == "attn_queries" else "mlp_input"
+                    n = f"llm.layers.{layer}.{which}.query"
+            elif n == "llm.middle_cycle_cross_pass_queries":
+                n = "llm.cross_pass_queries"
+            elif n == "llm.middle_cycle_cross_pass_kv_queries":
+                n = "llm.cross_pass_kv_queries"
+            elif n in ("llm.embed.weight", "llm.unembed.weight"):
+                tensor = tensor[: cfg.vocab_size]
+            else:
+                for a, b in self._RENAMES:
+                    n = n.replace(a, b)
+            param = params.get(n)
+            if param is None:
+                raise KeyError(f"Inkling2: no parameter for checkpoint tensor {name} ({n})")
+            loader = getattr(param, "weight_loader", default_weight_loader)
+            loader(param, tensor)
+            loaded.add(n)
+        for layer in self.llm.layers:
+            layer.attn.finalize()
+            if layer.is_local:
+                layer._norm_stack = layer.attn_norm.weight.data.unsqueeze(0).expand(3, -1).contiguous()
+            else:
+                layer._norm_stack = torch.stack(
+                    [layer.k_input_norm.weight.data, layer.v_input_norm.weight.data, layer.q_input_norm.weight.data]
+                ).contiguous()
+            if layer.is_loop:
+                gates = [layer.controllers[k] for k in ("attn", "k", "v", "mlp")]
+                for g in gates:
+                    g.finalize()
+                head = gates[0]
+                head._down_stack = torch.stack([g.down_weight for g in gates[:3]]).contiguous()
+                head._fg_stack = torch.stack([g.fg_weight for g in gates[:3]]).contiguous()
+                gates[3]._down_1 = gates[3].down_weight.unsqueeze(0).contiguous()
+                gates[3]._fg_1 = gates[3].fg_weight.unsqueeze(0).contiguous()
+        if self.text_config.loop_config is not None:
+            qq, kv = self.llm.cross_pass_queries, self.llm.cross_pass_kv_queries
+            n = qq.shape[0] // 2
+            self.llm._message_queries = torch.stack(
+                [qq[0::2], kv[0::2], kv[1::2], qq[1::2]], dim=1
+            ).float().contiguous()  # [n, 4, H]
+        missing = [k for k in params if k not in loaded]
+        if missing:
+            raise RuntimeError(f"Inkling2: {len(missing)} parameters not loaded, e.g. {missing[:8]}")
+        return loaded
+
+
+class Inkling2LoopForConditionalGeneration(Inkling2ForConditionalGeneration):
+    pass
+
+
+EntryClass = [Inkling2ForConditionalGeneration, Inkling2LoopForConditionalGeneration]
