@@ -0,0 +1,110 @@
+"""Inkling 2 image inputs: one image placeholder per image in the prompt (the chat
+template's <|unused_200054|>), expanded to one token per merged vision patch."""
+
+from __future__ import annotations
+
+import base64
+from collections.abc import Mapping
+
+from sglang.srt.managers.schedule_batch import MultimodalDataItem, MultimodalProcessorOutput
+from sglang.srt.models.inkling2 import (
+    Inkling2ForConditionalGeneration,
+    Inkling2LoopForConditionalGeneration,
+)
+from sglang.srt.multimodal.inkling2 import Inkling2ImageProcessor
+from sglang.srt.multimodal.modality import Modality
+from sglang.srt.multimodal.processors.base_processor import BaseMultimodalProcessor
+from sglang.srt.parser.inkling_tokenizer import IMAGE_TOKEN_ID
+from sglang.srt.utils.common import download_remote_media
+
+# The chat template's image placeholder token.
+TEMPLATE_IMAGE_TOKEN_ID = 200054
+
+
+class Inkling2Processor:
+    def __init__(self, tokenizer, image_processor: Inkling2ImageProcessor):
+        self.tokenizer = tokenizer
+        self.image_processor = image_processor
+
+    @classmethod
+    def from_pretrained(cls, path, *, revision=None, trust_remote_code=False, **kwargs):
+        from sglang.srt.utils.hf_transformers.tokenizer import get_tokenizer
+
+        return cls(
+            get_tokenizer(path, revision=revision, trust_remote_code=trust_remote_code),
+            Inkling2ImageProcessor.from_pretrained(path, revision=revision),
+        )
+
+
+def _resolve_image(item):
+    """ImageData / {url} / data: URL / http(s) URL -> bytes; bytes, paths, PIL unchanged."""
+    url = None
+    if isinstance(item, str):
+        url = item
+    elif isinstance(item, Mapping):
+        url = item.get("url")
+    elif hasattr(item, "url"):
+        url = item.url
+    if not isinstance(url, str):
+        return item
+    if url.startswith("data:"):
+        header, _, payload = url.partition(",")
+        return base64.b64decode(payload) if ";base64" in header else payload.encode()
+    if url.startswith(("http://", "https://")):
+        return download_remote_media(url, timeout=30)
+    return url
+
+
+class Inkling2MultimodalProcessor(BaseMultimodalProcessor):
+    models = [Inkling2ForConditionalGeneration, Inkling2LoopForConditionalGeneration]
+    gpu_image_decode = False
+
+    def __init__(self, hf_config, server_args, processor, *args, **kwargs):
+        super().__init__(hf_config, server_args, processor, *args, **kwargs)
+        if getattr(hf_config, "vision_config", None) is None:
+            raise ValueError("Inkling2 image requests require vision_config")
+        self.image_processor = processor.image_processor
+        self.IMAGE_TOKEN_ID = IMAGE_TOKEN_ID
+
+    def assemble(self, input_ids: list[int], image_data=None) -> MultimodalProcessorOutput:
+        ids = [IMAGE_TOKEN_ID if t == TEMPLATE_IMAGE_TOKEN_ID else t for t in input_ids]
+        images = list(image_data or [])
+        count = ids.count(IMAGE_TOKEN_ID)
+        if count != len(images):
+            raise ValueError(f"Image placeholder count {count} does not match image count {len(images)}")
+        if not images:
+            return MultimodalProcessorOutput(input_ids=ids, mm_items=[], im_token_id=IMAGE_TOKEN_ID)
+        features = self.image_processor.preprocess([_resolve_image(i) for i in images])
+        items, out, patch_offset = [], [], 0
+        for token in ids:
+            if token != IMAGE_TOKEN_ID:
+                out.append(token)
+                continue
+            index = len(items)
+            num_tokens = features["num_tokens"][index]
+            start = len(out)
+            out.extend([IMAGE_TOKEN_ID] * num_tokens)
+            items.append(
+                MultimodalDataItem(
+                    modality=Modality.IMAGE,
+                    feature=features["vision_patches_bthwc"][patch_offset : patch_offset + num_tokens],
+                    offsets=[(start, len(out) - 1)],
+                    model_specific_data={"vision_grid_thw": features["vision_grid_thw"][index : index + 1]},
+                )
+            )
+            patch_offset += num_tokens
+        return MultimodalProcessorOutput(input_ids=out, mm_items=items, im_token_id=IMAGE_TOKEN_ID)
+
+    async def process_mm_data_async(self, image_data=None, audio_data=None, input_text="", request_obj=None, *args, **kwargs):
+        if audio_data or getattr(request_obj, "video_data", None):
+            raise ValueError("Inkling2 supports text and images only")
+        input_ids = getattr(request_obj, "input_ids", None)
+        if input_ids is None:
+            input_ids = (
+                self._tokenizer.encode(input_text, add_special_tokens=False)
+                if isinstance(input_text, str)
+                else input_text
+            )
+        if hasattr(input_ids, "tolist"):
+            input_ids = input_ids.flatten().tolist()
+        return self.assemble(list(input_ids), image_data)
