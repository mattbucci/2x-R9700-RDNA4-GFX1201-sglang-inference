@@ -16,6 +16,8 @@ from sglang.srt.function_call.core_types import (
 from sglang.srt.parser.inkling_tokenizer import (
     CONTENT_INVOKE_TOOL_JSON,
     CONTENT_INVOKE_TOOL_TEXT,
+    CONTENT_TEXT,
+    CONTENT_THINKING,
     END_MESSAGE,
     INKLING_CONTROL_TOKENS,
     INKLING_SPECIAL_TOKEN_IDS,
@@ -47,6 +49,52 @@ class InklingDetector(BaseFormatDetector):
         self._stream_call_index = 0
         self._raw_passthrough = False
 
+    @classmethod
+    def tool_choice_none_structural_tag(cls) -> StructuralTag:
+        """Every model message must open with a thinking or text kind.
+
+        A call is decided at the header: ``<|message_model|>`` followed by a
+        tool name. A tool-heavy context with its tools stripped still draws
+        calls, which reach the client as raw markup, and banning only the
+        invoke kinds leaves a headed message the parser drops.
+        """
+        ids = INKLING_SPECIAL_TOKEN_IDS
+        invoke = [ids[CONTENT_INVOKE_TOOL_JSON], ids[CONTENT_INVOKE_TOOL_TEXT]]
+        return StructuralTag.model_validate(
+            {
+                "type": "structural_tag",
+                "format": {
+                    "type": "token_triggered_tags",
+                    "trigger_tokens": [ids[MESSAGE_MODEL]],
+                    "exclude_tokens": invoke,
+                    "tags": [
+                        {
+                            "type": "tag",
+                            "begin": {"type": "token", "token": ids[MESSAGE_MODEL]},
+                            "content": {
+                                "type": "sequence",
+                                "elements": [
+                                    {
+                                        "type": "or",
+                                        "elements": [
+                                            {"type": "token", "token": ids[CONTENT_THINKING]},
+                                            {"type": "token", "token": ids[CONTENT_TEXT]},
+                                        ],
+                                    },
+                                    {
+                                        "type": "any_tokens",
+                                        "exclude_tokens": [ids[END_MESSAGE], ids[MESSAGE_MODEL]]
+                                        + invoke,
+                                    },
+                                ],
+                            },
+                            "end": {"type": "token", "token": ids[END_MESSAGE]},
+                        }
+                    ],
+                },
+            }
+        )
+
     def has_tool_call(self, text: str) -> bool:
         return self.bot_token in text or CONTENT_INVOKE_TOOL_TEXT in text
 
