+    def test_tool_choice_none_keeps_inkling_tools_under_a_no_call_grammar(self):
+        """A tool-heavy Inkling context with its tools stripped still draws a call,
+        which reaches the client as raw markup; the tools stay and a grammar rules
+        the call out at the message header."""
+        self.template_manager.chat_template_name = None
+        self.template_manager.jinja_template_content_format = "string"
+        self.tm.tokenizer.apply_chat_template.return_value = [1, 2, 3]
+        tools = [{"type": "function", "function": {"name": "lookup"}}]
+        user = [{"role": "user", "content": "Summarize."}]
+        for parser, keeps in (("hermes", False), ("inkling2", True)):
+            with self.subTest(parser=parser):
+                self.chat.tool_call_parser = parser
+                request = ChatCompletionRequest(
+                    model="x", messages=user, tools=tools, tool_choice="none"
+                )
+                processed = self.chat._process_messages(request, is_multimodal=False)
+                kwargs = self.tm.tokenizer.apply_chat_template.call_args.kwargs
+                self.assertEqual(bool(kwargs.get("tools")), keeps)
+                constraint = processed.tool_call_constraint
+                self.assertEqual(constraint is not None, keeps)
+                if keeps:
+                    self.assertEqual(constraint[0], "structural_tag")
+                    tag = constraint[1].model_dump(by_alias=True)["format"]
+                    self.assertEqual(tag["trigger_tokens"], [200001])
+                    self.assertEqual(sorted(tag["exclude_tokens"]), [200049, 200057])
+                self.assertFalse(self.chat._tool_call_parsing_active(request))
+
