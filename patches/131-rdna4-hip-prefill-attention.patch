+// SPDX-License-Identifier: Apache-2.0
+//
+// Launch arguments of the prefill attention kernel in r4d_attn_prefill_h256_gqa6.inc. The struct keeps the name
+// and the field names of radiance's R4DArgs (libr4d/r4d.h) for the fields the kernel reads, so the kernel text
+// stays close to its origin; v and ctx are added, everything the kernel does not read is left out.
+#pragma once
+#include <hip/hip_runtime.h>
+#include <cstdint>
+
+struct R4DArgs {
+    const void* q;           // bf16 [query rows][q_heads][head_dim]
+    const void* kv;          // K pool: e4m3 bytes, token slot s and KV head h at s * kv_block_stride + h * kv_head_stride
+    const void* v;           // V pool, the layout of the K pool
+    const int* block_table;  // [ctx] pool slot of every token of the sequence (block size 1)
+    void* out;               // bf16, the layout of q
+    const float* k_descale;  // per (sequence, KV head) or null for 1.0
+    const float* v_descale;  // per (sequence, KV head) or null for 1.0
+    void* scratch;           // the split form's partials (not instantiated here)
+    const int* cu_q;         // per-sequence query offsets or null: every sequence has q_len rows
+    long kv_block_stride;
+    long kv_head_stride;
+    int num_seqs, q_len, q_heads, kv_heads, max_blocks;
+    int ctx;                 // tokens of the sequence; the queries are its last q_len
+    int splits, window, total_q;
+    float scale;
+};
+
+__host__ __device__ __forceinline__ int r4d_q_total(const R4DArgs& a) {
+    return a.cu_q ? a.total_q : a.num_seqs * a.q_len;
+}
diff --git a/python/sglang/kernels/aot/csrc/attention/prefill_attn_fp8_hip/prefill_attn_fp8_hip.cu b/python/sglang/kernels/aot/csrc/attention/prefill_attn_fp8_hip/prefill_attn_fp8_hip.cu
