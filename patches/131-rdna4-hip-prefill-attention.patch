index 0000000..aab9a70
--- /dev/null
+++ b/python/sglang/kernels/aot/csrc/attention/prefill_attn_fp8_hip/prefill_attn_fp8_hip.cu
@@ -0,0 +1,117 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// Prefill (extend) attention over an fp8 e4m3 KV cache on gfx1201 (RDNA4), head dimension 256 with six
+// query heads per KV head: one launch computes the chunk's rows over the whole sequence (prefix and the
+// chunk's own keys, causal), reading K and V bytes straight from SGLang's two pools through a per-token
+// slot table.
+//
+// The kernel is radiance (Apache-2.0, Copyright 2026 Deadcode and the radiance contributors, https://codeberg.org/StillDeadcode/radiance, revision 451b1368)
+// libr4d/r4d_attn_prefill_h256_gqa6.hip with the edits listed at the top of
+// r4d_attn_prefill_h256_gqa6.inc; r4d_common.h and r4d_dt16.h are that tree's files unchanged. This file
+// (the option word without block-table staging, the launch and the torch binding) is this repository's.
+//
+// legs: 0 = both products with f16 operands (exact over e4m3 K/V), 1 = QK as e4m3 x e4m3 (the query is
+// rounded to e4m3 once), 2 = PV as e4m3 x e4m3 (the softmax weights are rounded), 3 = both.
+
+#ifdef USE_ROCM
+
+#include <torch/all.h>
+#include <ATen/hip/HIPContext.h>
+#include <c10/hip/HIPGuard.h>
+#include <c10/hip/HIPStream.h>
+#include <hip/hip_runtime.h>
+#include <cmath>
+#include <cstdint>
+
+#include "r4d_attn_prefill_h256_gqa6.inc"
+
+namespace {
+
+constexpr int kWarps = 24;
+constexpr int kTile = 48;
+constexpr int kHeadDim = 256;
+constexpr int kGqa = 6;
+constexpr int kQueryRows = kWarps * 16 / kGqa;  // query positions per workgroup
+// radiance launches this kernel with 3954187 | O_KLATE over 16-token blocks. Here a block is one token
+// (the pools are indexed per token), so O_BTS, which stages a tile's TILE / BS table entries in scalar
+// registers, is left out and every fetch reads its own table entry.
+constexpr int kOpt = (3954187 | O_KLATE) & ~O_BTS;
+
+template <int XOPT>
+void launch(const R4DArgs& a, hipStream_t stream) {
+  const dim3 grid((a.q_len + kQueryRows - 1) / kQueryRows, a.kv_heads, 1);
+  hipLaunchKernelGGL((r4d_attn_prefill_kernel<kWarps, kTile, kHeadDim, kGqa, 1, 0, kOpt | XOPT>), grid,
+                     dim3(kWarps * 32), 0, stream, a);
+}
+
+}  // namespace
+
+void prefill_attn_fp8_hip(at::Tensor q, at::Tensor k_pool, at::Tensor v_pool, at::Tensor slots,
+                          at::Tensor out, double scale, int64_t legs) {
+  TORCH_CHECK(q.is_cuda() && k_pool.is_cuda() && v_pool.is_cuda() && slots.is_cuda() && out.is_cuda(),
+              "prefill_attn_fp8_hip: every tensor must be on the GPU");
+  TORCH_CHECK(q.get_device() == k_pool.get_device() && q.get_device() == v_pool.get_device() &&
+                  q.get_device() == slots.get_device() && q.get_device() == out.get_device(),
+              "prefill_attn_fp8_hip: every tensor must be on one device");
+  TORCH_CHECK(q.scalar_type() == at::ScalarType::BFloat16 && out.scalar_type() == at::ScalarType::BFloat16,
+              "prefill_attn_fp8_hip: q and out must be bf16");
+  TORCH_CHECK(k_pool.scalar_type() == at::ScalarType::Float8_e4m3fn &&
+                  v_pool.scalar_type() == at::ScalarType::Float8_e4m3fn,
+              "prefill_attn_fp8_hip: the pools must be float8_e4m3fn");
+  TORCH_CHECK(slots.scalar_type() == at::ScalarType::Int, "prefill_attn_fp8_hip: slots must be int32");
+  TORCH_CHECK(q.dim() == 3 && out.dim() == 3 && k_pool.dim() == 3 && v_pool.dim() == 3 && slots.dim() == 1,
+              "prefill_attn_fp8_hip: q/out [rows][q heads][256], pools [slots][kv heads][256], slots [ctx]");
+  TORCH_CHECK(q.is_contiguous() && out.is_contiguous() && k_pool.is_contiguous() && v_pool.is_contiguous() &&
+                  slots.is_contiguous(),
+              "prefill_attn_fp8_hip: every tensor must be contiguous");
+  TORCH_CHECK(q.sizes() == out.sizes(), "prefill_attn_fp8_hip: out must have the shape of q");
+  TORCH_CHECK(k_pool.sizes() == v_pool.sizes(), "prefill_attn_fp8_hip: the pools must have one shape");
+  const int64_t rows = q.size(0), q_heads = q.size(1), kv_heads = k_pool.size(1), ctx = slots.size(0);
+  TORCH_CHECK(q.size(2) == kHeadDim && k_pool.size(2) == kHeadDim, "prefill_attn_fp8_hip: head dimension 256");
+  TORCH_CHECK(kv_heads >= 1 && q_heads == kGqa * kv_heads, "prefill_attn_fp8_hip: six query heads per KV head");
+  TORCH_CHECK(rows <= ctx && ctx <= INT32_MAX, "prefill_attn_fp8_hip: the queries are the last rows of ctx tokens");
+  TORCH_CHECK(legs >= 0 && legs <= 3, "prefill_attn_fp8_hip: legs must be 0..3");
+  TORCH_CHECK(std::isfinite(scale), "prefill_attn_fp8_hip: scale must be finite");
+  if (rows == 0) return;
+
+  R4DArgs a{};
+  a.q = q.data_ptr();
+  a.kv = k_pool.data_ptr();
+  a.v = v_pool.data_ptr();
+  a.block_table = slots.data_ptr<int>();
+  a.out = out.data_ptr();
+  a.kv_block_stride = static_cast<long>(kv_heads) * kHeadDim;
+  a.kv_head_stride = kHeadDim;
+  a.num_seqs = 1;
+  a.q_len = static_cast<int>(rows);
+  a.q_heads = static_cast<int>(q_heads);
+  a.kv_heads = static_cast<int>(kv_heads);
+  a.max_blocks = static_cast<int>(ctx);
+  a.ctx = static_cast<int>(ctx);
+  a.splits = 1;
+  a.total_q = static_cast<int>(rows);
+  a.scale = static_cast<float>(scale);
+
+  // The launch goes to the tensors' card, whichever card the calling thread has current.
+  const c10::cuda::CUDAGuard device_guard(q.device());
+  const auto stream = at::hip::getCurrentHIPStream(static_cast<c10::DeviceIndex>(q.get_device()));
+  switch (legs) {
+    case 0: launch<0>(a, stream); break;
+    case 1: launch<O_QK8>(a, stream); break;
+    case 2: launch<O_PV8>(a, stream); break;
+    default: launch<O_QK8 | O_PV8>(a, stream); break;
+  }
+}
+
+#endif  // USE_ROCM
+
+#ifdef USE_ROCM
+#include <torch/extension.h>
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+  m.def("prefill_attn_fp8_hip", &prefill_attn_fp8_hip,
+        "Causal prefill attention of the last rows of a sequence over fp8 K/V pools (gfx1201)",
+        py::arg("q"), py::arg("k_pool"), py::arg("v_pool"), py::arg("slots"), py::arg("out"),
+        py::arg("scale"), py::arg("legs") = 0);
+}
+#endif
