+def redact_sensitive_cli_args(argv: list[str]) -> list[str]:
+    """Return argv with values for credential-bearing ServerArgs removed."""
+    sensitive_options = {
+        f"--{name.replace('_', '-')}" for name in _sensitive_server_arg_fields()
+    }
+    result: list[str] = []
+    redact_next = False
+    for arg in argv:
+        if redact_next:
+            result.append("<redacted>")
+            redact_next = False
+            continue
+        matching_option = next(
+            (option for option in sensitive_options if arg.startswith(f"{option}=")),
+            None,
+        )
+        if matching_option:
+            result.append(f"{matching_option}=<redacted>")
+        else:
+            result.append(arg)
+            redact_next = arg in sensitive_options
+    return result
