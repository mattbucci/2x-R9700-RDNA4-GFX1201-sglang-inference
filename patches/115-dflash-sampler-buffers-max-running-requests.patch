+    def _draft_sampler_max_bs(self) -> int:
+        """Static sampler buffers are sliced by the live batch size. The scheduler batches
+        up to max_running_requests even when decode graphs stop at a smaller bs (the flint
+        preset pins --cuda-graph-max-bs-decode 1), and a second concurrent request then
+        crashed stage_sampling_params ("output with shape [1] doesn't match the broadcast
+        shape [2]"); size the buffers by the larger of the two."""
+        graph_bs = int(max(get_exec().graph.cuda_graph_config.decode.bs))
+        running = self.model_runner.max_running_requests
+        return max(graph_bs, int(running) if running else 1)
