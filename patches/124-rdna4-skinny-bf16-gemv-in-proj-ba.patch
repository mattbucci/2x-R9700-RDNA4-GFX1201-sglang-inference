+# RDNA4: the DeltaNet in_proj_ba is a few unquantised bf16 output rows (96 x 5120 on
+# Qwen3.8-27B); rocBLAS serves it with a tiled GEMM whose launch outweighs the 1 MB
+# it reads. Opt-in: SGLANG_RDNA4_SKINNY_BA_GEMV=1, exported by the launch presets that
+# passed the serving gate (fp32 accumulation in a fixed order, not rocBLAS's).
+_rdna4_skinny_ba_gemv = _is_hip and get_bool_env_var(
+    "SGLANG_RDNA4_SKINNY_BA_GEMV", "False"
+)
+
+
+class _RocmSkinnyGemvLinearMethod(UnquantizedLinearMethod):
+    """Unquantised linear whose decode row counts run the one-launch bf16 GEMV."""
+
+    _noted = False
+
+    def apply(self, layer, x, bias=None):
+        if rocm_skinny_bf16_gemv_supported(x, layer.weight, bias):
+            if not _RocmSkinnyGemvLinearMethod._noted:
+                _RocmSkinnyGemvLinearMethod._noted = True
+                logger.info(
+                    "[RDNA4] DeltaNet in_proj_ba: one-launch Triton GEMV active"
+                )
+            return rocm_skinny_bf16_gemv(x, layer.weight)
+        return super().apply(layer, x, bias)
+
