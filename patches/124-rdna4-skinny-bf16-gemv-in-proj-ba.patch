+"""Skinny bf16 GEMV on gfx1201 for decode row counts: x[M, K] @ w[N, K].T with a few
+output rows (the Qwen3.5 DeltaNet in_proj_ba gate projection) in one launch.
+
+rocBLAS serves this shape with a tiled GEMM solution whose launch costs more than the
+1 MB of weight it reads. Each program owns one input row and BLOCK_N output rows and
+accumulates in fp32 in a fixed K order, so a row's result does not depend on M."""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+# rows served; above this the tiled GEMM wins back its launch cost
+ROCM_SKINNY_GEMV_MAX_ROWS = 16
+ROCM_SKINNY_GEMV_MAX_N = 256
+
+_BLOCK_N = 8
+_BLOCK_K = 512
+_NUM_WARPS = 4
+
+
+def rocm_skinny_bf16_gemv_supported(
+    x: torch.Tensor, w: torch.Tensor, bias: torch.Tensor | None
+) -> bool:
+    """True when rocm_skinny_bf16_gemv serves x[M, K] @ w[N, K].T (callers gate on HIP)."""
+    return (
+        bias is None
+        and x.dim() == 2
+        and w.dim() == 2
+        and x.dtype == torch.bfloat16
+        and w.dtype == torch.bfloat16
+        and 0 < x.shape[0] <= ROCM_SKINNY_GEMV_MAX_ROWS
+        and 0 < w.shape[0] <= ROCM_SKINNY_GEMV_MAX_N
+        and x.shape[1] == w.shape[1]
+        and x.stride(1) == 1
+        and w.stride(1) == 1
+    )
+
+
+@triton.jit
+def _skinny_bf16_gemv_kernel(
+    x_ptr,
+    w_ptr,
+    out_ptr,
+    N,
+    K,
+    stride_xm,
+    stride_wn,
+    stride_om,
+    BLOCK_N: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+):
+    pid_n = tl.program_id(0)
+    pid_m = tl.program_id(1)
+    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)
+    n_mask = offs_n < N
+    acc = tl.zeros((BLOCK_N,), dtype=tl.float32)
+    for k0 in range(0, K, BLOCK_K):
+        offs_k = k0 + tl.arange(0, BLOCK_K)
+        k_mask = offs_k < K
+        x = tl.load(x_ptr + pid_m * stride_xm + offs_k, mask=k_mask, other=0.0)
+        w = tl.load(
+            w_ptr + offs_n[:, None] * stride_wn + offs_k[None, :],
+            mask=n_mask[:, None] & k_mask[None, :],
+            other=0.0,
+        )
+        acc += tl.sum(w.to(tl.float32) * x.to(tl.float32)[None, :], axis=1)
+    tl.store(out_ptr + pid_m * stride_om + offs_n, acc.to(tl.bfloat16), mask=n_mask)
+
+
+def rocm_skinny_bf16_gemv(x: torch.Tensor, w: torch.Tensor) -> torch.Tensor:
+    """x[M, K] @ w[N, K].T in bf16 with fp32 accumulation, one launch."""
+    M, K = x.shape
+    N = w.shape[0]
+    out = torch.empty((M, N), dtype=torch.bfloat16, device=x.device)
+    _skinny_bf16_gemv_kernel[(triton.cdiv(N, _BLOCK_N), M)](
+        x,
+        w,
+        out,
+        N,
+        K,
+        x.stride(0),
+        w.stride(0),
+        out.stride(0),
+        BLOCK_N=_BLOCK_N,
+        BLOCK_K=_BLOCK_K,
+        num_warps=_NUM_WARPS,
+    )
+    return out
