+from sglang.srt.utils import get_bool_env_var
+
+
+def qwen3_5_deltanet_tp_split() -> bool:
+    """RDNA4: shard the DeltaNet projections and recurrent state over the TP ranks.
+
+    SGLANG_RDNA4_DELTANET_TP_SPLIT=1 selects the upstream layout: each rank reads its
+    half of in_proj_qkvz / out_proj and owns its half of the heads' state. The default
+    keeps the replicated layout, where every rank reads the whole projection.
+    """
+    return get_bool_env_var("SGLANG_RDNA4_DELTANET_TP_SPLIT")
 
 
