@@ -0,0 +1,165 @@
+"""Inkling 2 decode launch fusion (RDNA4).
+
+sconv_tail: the short convolution of a sublayer output, its cache update and the residual
+add in one launch. kv_sconv_post: the k and v short convolutions, their cache updates, the
+k norm clamp and the v RMS norm in one launch.
+
+out = [resid +] bf16(scale * (conv(bf16(x)) + bf16(x)))
+
+This is short_convolution (static weights, decode) followed by the residual add, with the
+same operation order and rounding points, so the result equals the three-launch path bit
+for bit. x may be the FP32 all-reduce sum; it is rounded to BF16 on load.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _sconv_tail_kernel(
+    X, Weight, Cache, Indices, Mask, TrackMask, TrackIndices, Resid, Out,
+    SX: tl.constexpr,
+    SW0: tl.constexpr,
+    SW1: tl.constexpr,
+    SC0: tl.constexpr,
+    SC1: tl.constexpr,
+    SC2: tl.constexpr,
+    D: tl.constexpr,
+    W: tl.constexpr,
+    TRACK: tl.constexpr,
+    HAS_RESID: tl.constexpr,
+    SCALE: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    col = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    valid = col < D
+    slot = tl.load(Indices + row).to(tl.int64)
+    # Graph padding rows map to the reserved slot 0 and neither read nor write it.
+    has_cache = (tl.load(Mask + row) != 0) & (slot > 0)
+    current = tl.load(X + row * SX + col, valid, other=0).to(tl.bfloat16).to(tl.float32)
+    acc = tl.full((BLOCK,), 0, tl.float32)
+    for tap in tl.static_range(W):
+        if tap == W - 1:
+            value = current
+        else:
+            value = tl.load(Cache + slot * SC0 + tap * SC1 + col * SC2, valid & has_cache, other=0).to(tl.float32)
+        weight = tl.load(Weight + col * SW0 + tap * SW1, valid, other=0).to(tl.bfloat16).to(tl.float32)
+        acc = tl.fma(value, weight, acc)
+    acc = acc + current
+    acc = acc * SCALE
+    y = acc.to(tl.bfloat16).to(tl.float32)
+    if HAS_RESID:
+        y = tl.load(Resid + row * D + col, valid, other=0).to(tl.float32) + y
+    tl.store(Out + row * D + col, y, valid)
+    for tap in tl.static_range(W - 1):
+        if tap == W - 2:
+            value = current
+        else:
+            value = tl.load(Cache + slot * SC0 + (tap + 1) * SC1 + col * SC2, valid & has_cache, other=0)
+        tl.store(Cache + slot * SC0 + tap * SC1 + col * SC2, value, valid & has_cache)
+        if TRACK:
+            track = tl.load(TrackMask + row)
+            dest = tl.load(TrackIndices + row).to(tl.int64)
+            tl.store(Cache + dest * SC0 + tap * SC1 + col * SC2, value, valid & has_cache & track)
+
+
+def sconv_tail(x, weight, cache, metadata, resid, out_dtype, *, track_mask=None, track_indices=None):
+    """x [T, D] BF16 or FP32, weight [D, W], cache [slots, W - 1, D], resid [T, D] or None.
+    Returns [T, D] in out_dtype and updates the conv cache."""
+    T, D = x.shape
+    W = weight.shape[1]
+    out = torch.empty((T, D), dtype=out_dtype, device=x.device)
+    if T:
+        assert x.stride(1) == 1 and cache.shape[1:] == (W - 1, D)
+        assert resid is None or resid.is_contiguous()
+        assert (track_mask is None) == (track_indices is None)
+        _sconv_tail_kernel[(T, triton.cdiv(D, 256))](
+            x, weight, cache, metadata["safe_idx"], metadata["cache_mask"], track_mask, track_indices,
+            resid, out, x.stride(0), *weight.stride(), *cache.stride(), D, W,
+            track_mask is not None, resid is not None, (W + 1) ** -0.5, 256,
+            enable_fp_fusion=False,
+        )
+    return out
+
+
+@triton.jit
+def _kv_conv(X, Weight, Cache, row, slot, has_cache, col, TrackMask, TrackIndices,
+             SX: tl.constexpr, SW0: tl.constexpr, SW1: tl.constexpr, SC0: tl.constexpr, SC1: tl.constexpr,
+             SC2: tl.constexpr, W: tl.constexpr, TRACK: tl.constexpr, SCALE: tl.constexpr, BLOCK: tl.constexpr):
+    current = tl.load(X + row * SX + col).to(tl.float32)
+    acc = tl.zeros_like(current)
+    for tap in tl.static_range(W):
+        if tap == W - 1:
+            value = current
+        else:
+            value = tl.load(Cache + slot * SC0 + tap * SC1 + col * SC2, has_cache, other=0).to(tl.float32)
+        weight = tl.load(Weight + col * SW0 + tap * SW1).to(tl.bfloat16).to(tl.float32)
+        acc = tl.fma(value, weight, acc)
+    acc = acc + current
+    acc = acc * SCALE
+    for tap in tl.static_range(W - 1):
+        if tap == W - 2:
+            value = current
+        else:
+            value = tl.load(Cache + slot * SC0 + (tap + 1) * SC1 + col * SC2, has_cache, other=0)
+        tl.store(Cache + slot * SC0 + tap * SC1 + col * SC2, value, has_cache)
+        if TRACK:
+            track = tl.load(TrackMask + row)
+            dest = tl.load(TrackIndices + row).to(tl.int64)
+            tl.store(Cache + dest * SC0 + tap * SC1 + col * SC2, value, has_cache & track)
+    return acc.to(tl.bfloat16).to(tl.float32)
+
+
+@triton.jit
+def _kv_tail_kernel(
+    K, V, WK, WV, CK, CV, IK, MK, IV, MV, TrackMask, TKI, TVI, OutK, OutV,
+    qk_threshold, eps,
+    SK: tl.constexpr, SV: tl.constexpr,
+    SWK0: tl.constexpr, SWK1: tl.constexpr, SWV0: tl.constexpr, SWV1: tl.constexpr,
+    SCK0: tl.constexpr, SCK1: tl.constexpr, SCK2: tl.constexpr,
+    SCV0: tl.constexpr, SCV1: tl.constexpr, SCV2: tl.constexpr,
+    D: tl.constexpr, W: tl.constexpr, TRACK: tl.constexpr, SCALE: tl.constexpr, HEAD: tl.constexpr,
+):
+    row = tl.program_id(0)
+    # one head per program and one warp: four elements per thread, the summation order of
+    # the compiled helper this replaces at its usual tile
+    # One head per program as a [1, HEAD] tile on one warp: the summation order of the
+    # compiled norm helper this replaces (a flat [HEAD] tile sums in another order and
+    # moves a BF16 result by one ulp in about 1 call in 500).
+    col = (tl.program_id(1) * HEAD + tl.arange(0, HEAD))[None, :]
+    slot = tl.load(IK + row).to(tl.int64)
+    has_cache = (tl.load(MK + row) != 0) & (slot > 0)
+    k = _kv_conv(K, WK, CK, row, slot, has_cache, col, TrackMask, TKI, SK, SWK0, SWK1, SCK0, SCK1, SCK2, W, TRACK, SCALE, HEAD)
+    norm = tl.sqrt_rn(tl.sum(k * k, 1))[:, None]
+    # reciprocal, then the threshold: the operation order of the compiled helper this replaces
+    k = k * tl.minimum((1.0 / (norm + 1e-6)) * qk_threshold, 1.0)
+    tl.store(OutK + row * D + col, k)
+    slot = tl.load(IV + row).to(tl.int64)
+    has_cache = (tl.load(MV + row) != 0) & (slot > 0)
+    v = _kv_conv(V, WV, CV, row, slot, has_cache, col, TrackMask, TVI, SV, SWV0, SWV1, SCV0, SCV1, SCV2, W, TRACK, SCALE, HEAD)
+    v = v * tl.rsqrt(tl.sum(v * v, 1)[:, None] / HEAD + eps)
+    tl.store(OutV + row * D + col, v)
+
+
+def kv_sconv_post(k, v, wk, wv, ck, cv, meta_k, meta_v, head_dim, qk_threshold, eps, *,
+                  track_mask=None, track_k=None, track_v=None):
+    """Decode, static weights: the k and v short convolutions (with cache updates), the
+    k norm clamp and the v RMS norm in one launch. k, v: BF16 [T, D] (row stride free).
+    Returns BF16 k, v [T, D]."""
+    T, D = k.shape
+    W = wk.shape[1]
+    assert k.dtype == v.dtype == torch.bfloat16 and D % head_dim == 0 and k.stride(1) == v.stride(1) == 1
+    assert ck.shape[1:] == cv.shape[1:] == (W - 1, D)
+    out_k = torch.empty((T, D), dtype=torch.bfloat16, device=k.device)
+    out_v = torch.empty((T, D), dtype=torch.bfloat16, device=k.device)
+    if T:
+        _kv_tail_kernel[(T, D // head_dim)](
+            k, v, wk, wv, ck, cv, meta_k["safe_idx"], meta_k["cache_mask"], meta_v["safe_idx"], meta_v["cache_mask"],
+            track_mask, track_k, track_v, out_k, out_v, qk_threshold, eps,
+            k.stride(0), v.stride(0), *wk.stride(), *wv.stride(), *ck.stride(), *cv.stride(),
+            D, W, track_mask is not None, (W + 1) ** -0.5, head_dim,
+            enable_fp_fusion=False, num_warps=1,
+        )
+    return out_k, out_v
