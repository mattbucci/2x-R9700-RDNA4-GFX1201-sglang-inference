+  m.def("inkling2_nvfp4_hip", &inkling2_nvfp4_hip,
+        "NVFP4 routed-expert GEMM over per-expert runs, bf16 activations (HIP/ROCm)",
+        py::arg("x"), py::arg("weight"), py::arg("scale"), py::arg("factor"), py::arg("run_e"),
+        py::arg("run_s"), py::arg("top_k"), py::arg("swiglu"), py::arg("gate_cap") = 0.0,
+        py::arg("up_cap") = 0.0, py::arg("ks") = 1, py::arg("nt") = 1);
+  m.def("inkling2_mxfp8_hip", &inkling2_mxfp8_hip,
