+        py::arg("x"), py::arg("weight"), py::arg("scale"), py::arg("run_e"), py::arg("run_s"),
+        py::arg("top_k"), py::arg("swiglu"), py::arg("gate_cap") = 0.0, py::arg("up_cap") = 0.0,
+        py::arg("nt") = 1);
+  m.def("inkling2_seg_gemm_hip", &inkling2_seg_gemm_hip,
+        "bf16 GEMM for up to sixteen rows over a weight with per-segment inputs (HIP/ROCm)",
+        py::arg("x"), py::arg("weight"), py::arg("b1"), py::arg("b2"), py::arg("nt") = 1);
+}
