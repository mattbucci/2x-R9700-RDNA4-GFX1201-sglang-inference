diff --git a/python/sglang/kernels/ops/activation/softcap.py b/python/sglang/kernels/ops/activation/softcap.py
index d1025c45..6528c8f3 100644
--- a/python/sglang/kernels/ops/activation/softcap.py
+++ b/python/sglang/kernels/ops/activation/softcap.py
@@ -24,9 +24,11 @@ def softcap_inplace_logits_kernel(
 
     # Load values
     row_ptr = full_logits_ptr + row * row_stride
-    x = tl.load(row_ptr + offsets, mask=mask)
-    if CAST_TO_FP32:
-        x = x.to(tl.float32)
+    x_in = tl.load(row_ptr + offsets, mask=mask)
+    # Perform softcapping in FP32 for precision (BF16 tanh is lossy) — RDNA4 patch 027,
+    # relocated here in v0.5.13 (kernel moved out of logits_processor.py). The in-place
+    # path casts back to the logits dtype; CAST_TO_FP32 stores the FP32 result as is.
+    x = x_in.to(tl.float32)
 
     if APPLY_SOFTCAP:
         x = x / softcapping_value
@@ -37,7 +39,7 @@ def softcap_inplace_logits_kernel(
     if CAST_TO_FP32:
         tl.store(output_ptr + row * output_row_stride + offsets, x, mask=mask)
     else:
-        tl.store(row_ptr + offsets, x, mask=mask)
+        tl.store(row_ptr + offsets, x.to(x_in.dtype), mask=mask)
 
 
 def _softcap_logits(full_logits, final_logit_softcapping, output=None):
@@ -113,6 +115,9 @@ def _gathered_softcap_logits_kernel(
         - shard * shard_width,
         mask=mask,
     )
+    # RDNA4 patch 027: softcap the all-gathered logits in FP32 as well (the gathered
+    # tensor keeps the BF16 logits dtype; the output is FP32).
+    x = x.to(tl.float32)
     x = x / softcapping_value
     x = libdevice.tanh(x)
     x = x * softcapping_value
