diff --git b/python/sglang/srt/models/flint.py b/python/sglang/srt/models/flint.py
new file mode 100644
index 0000000..cdd4a0b
--- /dev/null
+++ b/python/sglang/srt/models/flint.py
@@ -0,0 +1,510 @@
+# Copyright 2023-2026 SGLang Team
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+"""Flint (RecursiveSI/flint): a 40B-total / 2.5B-active MoE coder built from
+SGLang's Qwen3-MoE blocks plus
+
+1. learned attention sinks: a per-head logit (``softmax_offset``) added to
+   the softmax denominator with no value contribution;
+2. hybrid attention: per-layer sliding-window or full attention from
+   ``config.layer_types``;
+3. no positional encoding on the layers in ``config.no_rope_layer_indices``;
+4. dense SwiGLU MLPs on ``config.mlp_only_layers``, sparse MoE elsewhere;
+5. sigmoid routing: top-k on sigmoid scores + expert bias (bias affects the
+   choice only), weights renormalised to one;
+6. an ungated shared expert added to every MoE block.
+
+Ported onto v0.5.22's ``layer_boundary`` stage framework from the vendor's
+``flint_sglang`` 0.1.4 kit (written for 0.5.16's ``LayerCommunicator``,
+Apache-2.0). The attention sinks ride the stock ``sinks`` argument of
+``RadixAttention``; the Triton extend and flash-decode kernels implement them
+(``HAS_SINK``), and the Lean decode path declines sink layers on its own.
+"""
+
+from __future__ import annotations
+
+import logging
+from typing import Iterable, List, Optional, Set, Tuple
+
+import torch
+from torch import nn
+
+from sglang.srt.configs.flint import SLIDING_ATTENTION, FlintConfig
+from sglang.srt.layers.layer_boundary import append_stages, declare_attn, declare_ffn
+from sglang.srt.layers.layernorm import RMSNorm
+from sglang.srt.layers.logits_processor import LogitsProcessor
+from sglang.srt.layers.moe.fused_moe_triton.layer import FusedMoE
+from sglang.srt.layers.moe.topk import TopK
+from sglang.srt.layers.quantization.base_config import QuantizationConfig
+from sglang.srt.layers.radix_attention import RadixAttention
+from sglang.srt.layers.utils import PPMissingLayer, get_layer_id
+from sglang.srt.layers.vocab_parallel_embedding import ParallelLMHead
+from sglang.srt.models.qwen3_moe import (
+    Qwen3MoeAttention,
+    Qwen3MoeDecoderLayer,
+    Qwen3MoeForCausalLM,
+    Qwen3MoeMLP,
+    Qwen3MoeModel,
+    Qwen3MoeSparseMoeBlock,
+)
+from sglang.srt.models.utils import apply_qk_norm
+from sglang.srt.runtime_context import get_exec, get_parallel, get_serving
+from sglang.srt.utils import LazyValue, add_prefix
+from sglang.srt.utils.hf_transformers_utils import get_rope_config
+
+logger = logging.getLogger(__name__)
+
+EXPERT_BIAS_SUFFIX = ".mlp.gate.expert_bias"
+SINK_SUFFIX = ".self_attn.softmax_offset"
+
+
+class FlintMLP(Qwen3MoeMLP):
+    """Dense or shared-expert SwiGLU MLP that accepts the decoder's optional
+    forward batch (the Qwen3-MoE layer passes one to every FFN)."""
+
+    def forward(self, hidden_states: torch.Tensor, forward_batch=None) -> torch.Tensor:
+        return super().forward(hidden_states)
+
+
+class FlintAttention(Qwen3MoeAttention):
+    """GQA with QK RMSNorm, learned sinks, an optional sliding window and
+    optional RoPE."""
+
+    def __init__(
+        self,
+        *,
+        layer_type: str,
+        skip_rope: bool,
+        sliding_window: int,
+        layer_id: int,
+        prefix: str = "",
+        **kwargs,
+    ) -> None:
+        super().__init__(layer_id=layer_id, prefix=prefix, **kwargs)
+        self.skip_rope = skip_rope
+        # The fused qk-norm/RoPE and fused KV-buffer paths assume RoPE on every
+        # layer and no sinks.
+        self.use_fused_qk_norm_rope = False
+        self.use_fused_qk_norm_rope_cpu = False
+        self.compatible_with_fused_kv_buffer = False
+
+        # Per-head sink logits for this rank's heads (sharded in load_weights).
+        self.softmax_offset = nn.Parameter(
+            torch.empty(self.num_heads, dtype=torch.bfloat16), requires_grad=False
+        )
+
+        # HF's sliding_window counts the current token; SGLang's excludes it.
+        self.attn = RadixAttention(
+            self.num_heads,
+            self.head_dim,
+            self.scaling,
+            num_kv_heads=self.num_kv_heads,
+            layer_id=layer_id,
+            sliding_window_size=(
+                (sliding_window - 1) if layer_type == SLIDING_ATTENTION else -1
+            ),
+            prefix=add_prefix("attn", prefix),
+        )
+
+    def apply_qk_norm_rope(self, qkv, positions, forward_batch):
+        q, k, v = qkv.split([self.q_size, self.kv_size, self.kv_size], dim=-1)
+        q, k = apply_qk_norm(
+            q=q,
+            k=k,
+            q_norm=self.q_norm,
+            k_norm=self.k_norm,
+            head_dim=self.head_dim,
+            alt_stream=self.alt_stream,
+        )
+        if not self.skip_rope:
+            q, k = self.rotary_emb(positions, q, k)
+        self._used_fused_qk_norm_rope_last_call = False
+        return q, k, v
+
+    def forward_core(self, intermediate_state):
+        hidden_states, forward_batch, inner_state = intermediate_state
+        if inner_state is None:
+            return hidden_states
+        q, k, v, fb = inner_state
+        attn_output = self.attn(q, k, v, fb, sinks=self.softmax_offset)
+        output, _ = self.o_proj(attn_output)
+        return output
+
+
+class FlintSparseMoeBlock(Qwen3MoeSparseMoeBlock):
+    """Sparse MoE block with sigmoid + expert-bias top-k routing and an
+    ungated shared expert."""
+
+    def __init__(
+        self,
+        layer_id: int,
+        config: FlintConfig,
+        quant_config: Optional[QuantizationConfig] = None,
+        prefix: str = "",
+    ) -> None:
+        super().__init__(layer_id, config, quant_config=quant_config, prefix=prefix)
+
+        # Checkpoints without a router bias leave this at zero. The bias
+        # steers the expert choice only; the routing weights are the raw
+        # sigmoid scores, renormalised (SGLang's sigmoid + correction_bias
+        # semantics, the same path Laguna validated on gfx1201).
+        self.gate.expert_bias = nn.Parameter(
+            torch.zeros(config.num_experts, dtype=torch.float32),
+            requires_grad=False,
+        )
+        self.topk = TopK(
+            top_k=config.num_experts_per_tok,
+            layer_id=layer_id,
+            renormalize=bool(getattr(config, "norm_topk_prob", True)),
+            use_grouped_topk=False,
+            scoring_func="sigmoid",
+            correction_bias=self.gate.expert_bias,
+        )
+
+        shared_size = getattr(config, "shared_expert_intermediate_size", 0) or 0
+        self.shared_expert = (
+            FlintMLP(
+                hidden_size=config.hidden_size,
+                intermediate_size=shared_size,
+                hidden_act=config.hidden_act,
+                quant_config=quant_config,
+                reduce_results=False,
+                prefix=add_prefix("shared_expert", prefix),
+            )
+            if shared_size > 0
+            else None
+        )
+
+    def forward(self, hidden_states: torch.Tensor, forward_batch=None) -> torch.Tensor:
+        if hidden_states.shape[0] == 0:
+            return hidden_states
+        shared_output = (
+            self.shared_expert(hidden_states)
+            if self.shared_expert is not None
+            else None
+        )
+        # Routed experts return this rank's partial sum (FusedMoE
+        # reduce_results=False); the FFN stage boundary completes it, so the
+        # TP-sharded shared expert's partial is added before that reduction.
+        output = super().forward(hidden_states, forward_batch)
+        if shared_output is not None:
+            output = output + shared_output
+        return output
+
+
+class FlintDecoderLayer(Qwen3MoeDecoderLayer):
+    """Pre-norm decoder layer: Flint attention, then a dense MLP or a sparse
+    MoE block, on the layer_boundary stages (forward and the TBO ops are
+    inherited from Qwen3MoeDecoderLayer)."""
+
+    def __init__(
+        self,
+        config: FlintConfig,
+        layer_id: int,
+        start_layer: int = 0,
+        quant_config: Optional[QuantizationConfig] = None,
+        prefix: str = "",
+        alt_stream: Optional[torch.cuda.Stream] = None,
+    ) -> None:
+        nn.Module.__init__(self)
+        self.config = config
+        self.hidden_size = config.hidden_size
+        self.layer_id = layer_id
+        rope_theta, _ = get_rope_config(config)
+        self.rope_theta = rope_theta
+
+        self.self_attn = FlintAttention(
+            hidden_size=self.hidden_size,
+            num_heads=config.num_attention_heads,
+            num_kv_heads=config.num_key_value_heads,
+            layer_id=layer_id,
+            start_layer=start_layer,
+            rope_theta=rope_theta,
+            rope_scaling=None,
+            max_position_embeddings=config.max_position_embeddings,
+            head_dim=config.head_dim,
+            rms_norm_eps=config.rms_norm_eps,
+            attention_bias=config.attention_bias,
+            config=config,
+            quant_config=quant_config,
+            prefix=add_prefix("self_attn", prefix),
+            alt_stream=alt_stream,
+            layer_type=config.layer_types[layer_id],
+            skip_rope=layer_id in set(config.no_rope_layer_indices),
+            sliding_window=config.sliding_window,
+        )
+
+        attn, ffn = self.stage_facts(config, layer_id)
+        self.is_layer_sparse = ffn.sparse
+        if self.is_layer_sparse:
+            self.mlp = FlintSparseMoeBlock(
+                layer_id=layer_id,
+                config=config,
+                quant_config=quant_config,
+                prefix=add_prefix("mlp", prefix),
+            )
+        else:
+            self.mlp = FlintMLP(
+                hidden_size=config.hidden_size,
+                intermediate_size=config.intermediate_size,
+                hidden_act=config.hidden_act,
+                quant_config=quant_config,
+                reduce_results=False,
+                prefix=add_prefix("mlp", prefix),
+            )
+
+        self.input_layernorm = RMSNorm(config.hidden_size, eps=config.rms_norm_eps)
+        self.post_attention_layernorm = RMSNorm(
+            config.hidden_size, eps=config.rms_norm_eps
+        )
+        self.attn_boundary, self.ffn_boundary = append_stages(
+            (attn, self.input_layernorm),
+            (ffn, self.post_attention_layernorm),
+        )
+
+    @staticmethod
+    def stage_facts(config: FlintConfig, layer_id: int):
+        """The stages the layer at ``layer_id`` declares, from the config
+        alone (the model's shared declaration function, see make_layers)."""
+        dense_layers = frozenset(config.mlp_only_layers)
+        is_layer_sparse = layer_id not in dense_layers
+        is_next_layer_sparse = (
+            layer_id + 1 < config.num_hidden_layers
+            and (layer_id + 1) not in dense_layers
+        )
+        return (
+            # Conventional attention (no recurrent state), so the HIP FP32
+            # attention-TP sum could opt out like Laguna/Qwen3-MoE
+            # (PLAIN_ADD_BF16_SUM, patches 080/084); that switch is retained
+            # only after an A/B on the rig, so the defensive default stays.
+            declare_attn(),
+            declare_ffn(
+                sparse=is_layer_sparse,
+                next_layer_sparse=is_next_layer_sparse,
+            ),
+        )
+
+
+class FlintModel(Qwen3MoeModel):
+    def __init__(
+        self,
+        config: FlintConfig,
+        quant_config: Optional[QuantizationConfig] = None,
+        prefix: str = "",
+    ) -> None:
+        super().__init__(
+            config,
+            quant_config=quant_config,
+            prefix=prefix,
+            decoder_layer_type=FlintDecoderLayer,
+        )
+
+
+class FlintForCausalLM(Qwen3MoeForCausalLM):
+    """Flint causal LM. Inherits forward / split prefill / EAGLE3 capture
+    from Qwen3MoeForCausalLM; builds the Flint stack directly instead of
+    letting the parent allocate a stock model first."""
+
+    def __init__(
+        self,
+        config: FlintConfig,
+        quant_config: Optional[QuantizationConfig] = None,
+        prefix: str = "",
+    ) -> None:
+        nn.Module.__init__(self)
+        _check_runtime(config)
+        self.pp_group = get_parallel().pp_group
+        self.config = config
+        self.quant_config = quant_config
+        self.model = FlintModel(config, quant_config, prefix=add_prefix("model", prefix))
+        self.lm_head = ParallelLMHead(
+            config.vocab_size,
+            config.hidden_size,
+            quant_config=quant_config,
+            prefix=add_prefix("lm_head", prefix),
+            use_attn_tp_group=get_parallel().enable_dp_lm_head,
+        )
+        self.logits_processor = LogitsProcessor(config)
+        self.capture_aux_hidden_states = False
+        self.routed_experts_weights_of_layer = LazyValue(
+            lambda: {
+                layer_id: self.model.layers[layer_id].mlp.get_moe_weights()
+                for layer_id in range(self.start_layer, self.end_layer)
+                if isinstance(self.model.layers[layer_id].mlp, Qwen3MoeSparseMoeBlock)
+            }
+        )
+        self.attn_cp_size = get_parallel().attn_cp_size
+        self.moe_dp_size = get_parallel().moe_dp_size
+        self.stacked_params_mapping = [
+            ("qkv_proj", "q_proj", "q"),
+            ("qkv_proj", "k_proj", "k"),
+            ("qkv_proj", "v_proj", "v"),
+            ("gate_up_proj", "gate_proj", 0),
+            ("gate_up_proj", "up_proj", 1),
+        ]
+        self.expert_params_mapping = FusedMoE.make_expert_params_mapping(
+            ckpt_gate_proj_name="gate_proj",
+            ckpt_down_proj_name="down_proj",
+            ckpt_up_proj_name="up_proj",
+            num_experts=config.num_experts,
+        )
+
+    def get_attention_sliding_window_size(self) -> int:
+        # SGLang's window excludes the current token; the config's includes it.
+        return self.config.sliding_window - 1
+
+    def load_weights(
+        self, weights: Iterable[Tuple[str, torch.Tensor]], is_mtp: bool = False
+    ) -> None:
+        """Load checkpoint tensors through the Qwen3-MoE loader, sharding the
+        per-head sinks over attention TP, and fail if any checkpoint tensor
+        matched no parameter (or, on an unquantized load, any parameter went
+        unfilled)."""
+        params = dict(self.named_parameters())
+        loaded_targets: Set[str] = set()
+        unmatched: List[str] = []
+        attn_tp_size = get_parallel().attn_tp_size
+        attn_tp_rank = get_parallel().attn_tp_rank
+        off_stage_prefixes = tuple(
+            f"{n}." for n, m in self.named_modules() if isinstance(m, PPMissingLayer)
+        )
+
+        def canonical_weights() -> Iterable[Tuple[str, torch.Tensor]]:
+            for name, tensor in weights:
+                if name.endswith(SINK_SUFFIX):
+                    tensor = _shard_heads(tensor, attn_tp_size, attn_tp_rank)
+                target = _target_param_name(
+                    name, self.stacked_params_mapping, self.expert_params_mapping
+                )
+                if target in params:
+                    loaded_targets.add(target)
+                elif not self._skipped_by_parent_loader(
+                    name, target=target, is_mtp=is_mtp, off_stage_prefixes=off_stage_prefixes
+                ):
+                    unmatched.append(name)
+                yield name, tensor
+
+        Qwen3MoeForCausalLM.load_weights(self, canonical_weights(), is_mtp=is_mtp)
+        _check_load_coverage(
+            params=params,
+            loaded_targets=loaded_targets,
+            unmatched=unmatched,
+            check_missing=not is_mtp and self.quant_config is None,
+        )
+
+    def _skipped_by_parent_loader(
+        self, name: str, *, target: str, is_mtp: bool, off_stage_prefixes
+    ) -> bool:
+        """Checkpoint tensors the stock loader drops on purpose: other
+        stages/ranks, MTP, RoPE buffers, extra biases."""
+        layer_id = get_layer_id(name)
+        return (
+            (
+                layer_id is not None
+                and not self.model.start_layer <= layer_id < self.model.end_layer
+            )
+            or (bool(off_stage_prefixes) and name.startswith(off_stage_prefixes))
+            or _is_off_rank_expert(name, self.expert_params_mapping)
+            or ("mtp" in name) != is_mtp
+            or "rotary_emb.inv_freq" in name
+            or target.endswith(".bias")
+        )
+
+
+def _check_runtime(config: FlintConfig) -> None:
+    """Fail fast on flag combinations that silently change Flint's output."""
+    try:
+        grammar_backend = get_exec().kernel.grammar_backend
+        serving = get_serving()
+        reasoning_parser = serving.reasoning_parser
+        tool_call_parser = serving.tool_call_parser
+        strict_thinking = serving.enable_strict_thinking
+    except Exception as e:  # runtime context not published in this process
+        logger.warning("Flint: could not read server args for flag checks: %s", e)
+        return
+    flint_backend = grammar_backend == "flint"
+    if tool_call_parser == "flint" and not flint_backend:
+        raise RuntimeError(
+            f"--tool-call-parser flint requires --grammar-backend flint (got "
+            f"{grammar_backend}): without it Flint cannot reason before a tool call."
+        )
+    if flint_backend and reasoning_parser != "flint":
+        raise RuntimeError(
+            f"--grammar-backend flint requires --reasoning-parser flint (got "
+            f"{reasoning_parser}): it lets Flint reason before a constraint, and "
+            "that reasoning must be parsed as Flint writes it."
+        )
+    if flint_backend and strict_thinking:
+        raise RuntimeError(
+            "--enable-strict-thinking is not supported with --grammar-backend flint: "
+            "Flint's grammar already keeps stop and tool-call tokens out of its "
+            "reasoning, and there is no thinking budget."
+        )
+    if not flint_backend:
+        logger.warning(
+            "Flint is served without --grammar-backend flint: constrained requests "
+            "(tools, response_format) cannot reason before the constraint."
+        )
+    if not getattr(config, "enable_lm_head_fp32", False) and not (
+        get_exec().features.enable_fp32_lm_head
+    ):
+        logger.warning(
+            "Flint was validated with an FP32 LM head; outputs without it differ slightly."
+        )
+
+
+def _shard_heads(tensor: torch.Tensor, attn_tp_size: int, attn_tp_rank: int) -> torch.Tensor:
+    if tensor.shape[0] % attn_tp_size != 0:
+        raise ValueError(
+            f"{tensor.shape[0]} attention heads are not divisible by attention TP "
+            f"size {attn_tp_size}"
+        )
+    return tensor.chunk(attn_tp_size, dim=0)[attn_tp_rank]
+
+
+def _target_param_name(name: str, stacked_params_mapping, expert_params_mapping) -> str:
+    """Mirror the parent loader's name mapping to find the parameter a
+    checkpoint tensor fills."""
+    if "mlp.experts" not in name:
+        for param_name, weight_name, _ in stacked_params_mapping:
+            if weight_name in name:
+                return name.replace(weight_name, param_name)
+    for param_name, weight_name, _, _ in expert_params_mapping:
+        if weight_name in name:
+            return name.replace(weight_name, param_name)
+    return name
+
+
+def _is_off_rank_expert(name: str, expert_params_mapping) -> bool:
+    return "mlp.experts" in name and any(
+        weight_name in name for _, weight_name, _, _ in expert_params_mapping
+    )
+
+
+def _check_load_coverage(
+    *, params, loaded_targets: Set[str], unmatched: List[str], check_missing: bool
+) -> None:
+    if unmatched:
+        raise RuntimeError(
+            f"{len(unmatched)} checkpoint tensors match no Flint parameter, "
+            f"e.g. {unmatched[:5]}"
+        )
+    if not check_missing:
+        return
+    missing = sorted(
+        name
+        for name in params
+        if name not in loaded_targets and not name.endswith(EXPERT_BIAS_SUFFIX)
+    )
+    if missing:
+        raise RuntimeError(
+            f"{len(missing)} Flint parameters were not loaded from the checkpoint, "
+            f"e.g. {missing[:5]}"
+        )
+    logger.info("Flint weights loaded: %d parameters matched.", len(loaded_targets))
+
+
+EntryClass = FlintForCausalLM
diff --git a/python/sglang/srt/parser/reasoning_parser.py b/python/sglang/srt/parser/reasoning_parser.py
index 4dec025..2099165 100644
--- a/python/sglang/srt/parser/reasoning_parser.py
