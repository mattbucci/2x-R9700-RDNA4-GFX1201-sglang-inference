diff --git b/python/sglang/srt/configs/flint.py b/python/sglang/srt/configs/flint.py
new file mode 100644
index 0000000..d85fc1e
--- /dev/null
+++ b/python/sglang/srt/configs/flint.py
@@ -0,0 +1,159 @@
+# coding=utf-8
+# Copyright 2023-2026 SGLang Team
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+"""Flint (RecursiveSI/flint) model configuration.
+
+Transformers does not ship this architecture, so SGLang registers the class
+itself (``model_type: flint``) and the checkpoint loads without
+``--trust-remote-code``. Fields follow the published config.json and the
+vendor's ``flint_sglang`` 0.1.4 kit.
+
+Attention layers alternate between sliding-window layers (RoPE) and the
+full-attention layers listed in ``no_rope_layer_indices`` (no positional
+encoding). Every head carries a learned sink logit
+(``softmax_type="learnable"``, checkpoint tensor ``self_attn.softmax_offset``).
+Layers in ``mlp_only_layers`` use a dense SwiGLU MLP; all others are sparse
+MoE blocks with sigmoid router scores, top-k selection on score + expert bias,
+weights renormalised to one, plus an always-on, ungated shared expert.
+
+``sliding_window`` counts the current token (HF convention); SGLang's exclusive
+window is ``sliding_window - 1`` and the model reports it through
+``get_attention_sliding_window_size``.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Dict, List, Optional, Union
+
+from transformers.configuration_utils import PretrainedConfig
+
+SLIDING_ATTENTION = "sliding_attention"
+FULL_ATTENTION = "full_attention"
+
+
+class FlintConfig(PretrainedConfig):
+    model_type = "flint"
+    keys_to_ignore_at_inference = ["past_key_values"]
+
+    def __init__(
+        self,
+        vocab_size: int = 150144,
+        hidden_size: int = 2048,
+        intermediate_size: int = 6144,
+        num_hidden_layers: int = 49,
+        num_attention_heads: int = 32,
+        num_key_value_heads: int = 4,
+        head_dim: int = 128,
+        hidden_act: str = "silu",
+        max_position_embeddings: int = 262144,
+        initializer_range: float = 0.02,
+        rms_norm_eps: float = 1e-6,
+        use_cache: bool = True,
+        tie_word_embeddings: bool = False,
+        rope_theta: float = 10000.0,
+        rope_scaling: Optional[Dict[str, Any]] = None,
+        attention_bias: bool = False,
+        attention_dropout: float = 0.0,
+        use_sliding_window: bool = True,
+        sliding_window: Optional[int] = 513,
+        layer_types: Optional[List[str]] = None,
+        no_rope_layer_indices: Optional[List[int]] = None,
+        softmax_type: str = "learnable",
+        decoder_sparse_step: int = 1,
+        moe_intermediate_size: int = 512,
+        shared_expert_intermediate_size: int = 1024,
+        num_experts_per_tok: int = 6,
+        num_experts: int = 256,
+        norm_topk_prob: bool = True,
+        router_score_function: str = "sigmoid",
+        output_router_logits: bool = False,
+        router_aux_loss_coef: float = 0.0,
+        mlp_only_layers: Optional[List[int]] = None,
+        pad_token_id: Optional[int] = None,
+        bos_token_id: Optional[int] = None,
+        eos_token_id: Optional[Union[int, List[int]]] = None,
+        **kwargs,
+    ) -> None:
+        self.vocab_size = vocab_size
+        self.hidden_size = hidden_size
+        self.intermediate_size = intermediate_size
+        self.num_hidden_layers = num_hidden_layers
+        self.num_attention_heads = num_attention_heads
+        self.num_key_value_heads = num_key_value_heads
+        self.head_dim = head_dim
+        self.hidden_act = hidden_act
+        self.max_position_embeddings = max_position_embeddings
+        self.initializer_range = initializer_range
+        self.rms_norm_eps = rms_norm_eps
+        self.use_cache = use_cache
+        self.rope_theta = rope_theta
+        self.rope_scaling = rope_scaling
+        self.attention_bias = attention_bias
+        self.attention_dropout = attention_dropout
+        self.use_sliding_window = use_sliding_window
+        self.sliding_window = sliding_window if use_sliding_window else None
+        self.softmax_type = softmax_type
+        self.decoder_sparse_step = decoder_sparse_step
+        self.moe_intermediate_size = moe_intermediate_size
+        self.shared_expert_intermediate_size = shared_expert_intermediate_size
+        self.num_experts_per_tok = num_experts_per_tok
+        self.num_experts = num_experts
+        self.norm_topk_prob = norm_topk_prob
+        self.router_score_function = router_score_function
+        self.output_router_logits = output_router_logits
+        self.router_aux_loss_coef = router_aux_loss_coef
+        self.mlp_only_layers = list(mlp_only_layers) if mlp_only_layers else []
+        self.no_rope_layer_indices = (
+            list(no_rope_layer_indices) if no_rope_layer_indices else []
+        )
+        self.layer_types = (
+            list(layer_types)
+            if layer_types
+            else [FULL_ATTENTION] * num_hidden_layers
+        )
+        if len(self.layer_types) != num_hidden_layers:
+            raise ValueError(
+                f"layer_types has {len(self.layer_types)} entries but "
+                f"num_hidden_layers is {num_hidden_layers}"
+            )
+        unknown = sorted(
+            set(self.layer_types) - {SLIDING_ATTENTION, FULL_ATTENTION}
+        )
+        if unknown:
+            raise ValueError(f"unknown Flint layer_types {unknown}")
+        if router_score_function != "sigmoid":
+            raise ValueError(
+                "Flint's SGLang port implements sigmoid routing only; "
+                f"got router_score_function={router_score_function!r}"
+            )
+
+        # Read by SGLang's hybrid sliding-window KV plumbing (1 = SWA layer).
+        self.hybrid_layer_pattern = [
+            int(t == SLIDING_ATTENTION) for t in self.layer_types
+        ]
+        self.is_hybrid_swa = self.sliding_window is not None and any(
+            self.hybrid_layer_pattern
+        )
+        # Learned per-head sink logits: ``self_attn.softmax_offset`` in the
+        # checkpoint. ``learnable_sink`` is the attribute SGLang's generic
+        # sink detection reads; the SWA_SINK_ARCHS entry covers the rest.
+        self.learnable_sink = softmax_type == "learnable"
+        # The vendor validated Flint with an FP32 LM head (``--enable-fp32-lm-head``);
+        # LogitsProcessor reads this attribute so the preset need not pass the flag.
+        self.enable_lm_head_fp32 = True
+
+        super().__init__(
+            pad_token_id=pad_token_id,
+            bos_token_id=bos_token_id,
+            eos_token_id=eos_token_id,
+            tie_word_embeddings=tie_word_embeddings,
+            **kwargs,
+        )
+
+
+__all__ = ["FlintConfig"]
