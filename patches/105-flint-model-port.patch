diff --git b/python/sglang/srt/constrained/flint_grammar_backend.py b/python/sglang/srt/constrained/flint_grammar_backend.py
new file mode 100644
index 0000000..a6a99b3
--- /dev/null
+++ b/python/sglang/srt/constrained/flint_grammar_backend.py
@@ -0,0 +1,91 @@
+# Copyright 2023-2026 SGLang Team
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+"""``--grammar-backend flint``: XGrammar with Flint's optional reasoning before
+every constraint.
+
+Flint decides on each turn whether to reason, and its chat template has no
+thinking switch. With the stock backends a constraint (response format, regex,
+EBNF, structural tag, the ``flint`` tool-call grammar included) either applies
+from the first token, so Flint cannot reason, or, when a request declares
+thinking, only after a ``</think>``, so nothing is constrained when Flint
+answers directly. This backend compiles each constraint after an optional
+``<think>...</think>`` block instead. Legacy structural tags (``structures`` /
+``triggers``) are passed through unchanged. The ``flint`` reasoning parser
+moves the block out of ``content`` and never declares a request as thinking,
+so SGLang's reasoner wrapper starts every request in generation mode and this
+backend's grammar is live from the first token.
+
+Ported from the vendor's ``flint_sglang`` 0.1.4 kit (Apache-2.0).
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+
+from pydantic import ValidationError
+from xgrammar.structural_tag import (
+    Format,
+    GrammarFormat,
+    JSONSchemaFormat,
+    RegexFormat,
+    StructuralTag,
+)
+
+from sglang.srt.constrained.base_grammar_backend import (
+    BaseGrammarObject,
+    InvalidGrammarObject,
+)
+from sglang.srt.constrained.flint_structural_tags import reasoning_then
+from sglang.srt.constrained.utils import is_legacy_structural_tag
+from sglang.srt.constrained.xgrammar_backend import XGrammarGrammarBackend
+
+logger = logging.getLogger(__name__)
+
+GRAMMAR_BACKEND_NAME = "flint"
+
+
+class FlintGrammarBackend(XGrammarGrammarBackend):
+    """XGrammar backend that lets Flint reason before a json_schema, regex,
+    ebnf or structural-tag constraint."""
+
+    def __init__(self, tokenizer, **kwargs):
+        super().__init__(tokenizer, **kwargs)
+        self.tokenizer = tokenizer
+
+    def dispatch_json(self, key_string: str) -> BaseGrammarObject:
+        try:
+            schema = True if key_string == "$$ANY$$" else json.loads(key_string)
+        except json.JSONDecodeError as e:
+            logger.error(f"Hit invalid json_schema: {key_string=}, {e=}")
+            return InvalidGrammarObject(str(e))
+        return self._after_reasoning(JSONSchemaFormat(json_schema=schema))
+
+    def dispatch_regex(self, key_string: str) -> BaseGrammarObject:
+        return self._after_reasoning(RegexFormat(pattern=key_string))
+
+    def dispatch_ebnf(self, key_string: str) -> BaseGrammarObject:
+        return self._after_reasoning(GrammarFormat(grammar=key_string))
+
+    def dispatch_structural_tag(self, key_string: str) -> BaseGrammarObject:
+        try:
+            tag = json.loads(key_string)
+            if is_legacy_structural_tag(tag):
+                return super().dispatch_structural_tag(key_string)
+            self._sanitize_structural_format(tag["format"])
+            constraint = StructuralTag.model_validate(tag).format
+        except (json.JSONDecodeError, KeyError, AssertionError, ValidationError) as e:
+            logger.error(f"Hit invalid structural_tag: {key_string=}, {e=}")
+            return InvalidGrammarObject(str(e))
+        return self._after_reasoning(constraint)
+
+    def _after_reasoning(self, constraint: Format) -> BaseGrammarObject:
+        tag = reasoning_then(self.tokenizer, constraint)
+        return super().dispatch_structural_tag(tag.model_dump_json())
+
+
+__all__ = ["GRAMMAR_BACKEND_NAME", "FlintGrammarBackend"]
diff --git b/python/sglang/srt/constrained/flint_structural_tags.py b/python/sglang/srt/constrained/flint_structural_tags.py
new file mode 100644
index 0000000..c81ace6
--- /dev/null
+++ b/python/sglang/srt/constrained/flint_structural_tags.py
@@ -0,0 +1,149 @@
+# Copyright 2023-2026 SGLang Team
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+"""XGrammar structural tags for Flint's chat protocol.
+
+``build_flint_tool_grammar`` describes what Flint writes after its reasoning in
+a turn with tools: text free of protocol markers, then tool calls in Flint's
+format (``<tool_call>name<arg_key>k</arg_key><arg_value>v</arg_value></tool_call>``)
+to the request's tools: any number with ``tool_choice="auto"``, at least one with
+``"required"``, exactly one call of the named tool for a named choice, and at
+most one when the request sets ``parallel_tool_calls`` to false. The call tag is
+XGrammar's built-in ``glm_4_7`` structural tag, which is byte-identical to
+Flint's wire format: argument values follow a tool's JSON schema when the tool
+sets ``strict: true`` and are otherwise syntactically constrained but schema-free.
+
+``reasoning_then`` puts Flint's optional ``<think>...</think>`` block before a
+constraint; the ``flint`` grammar backend does that for every constraint, the
+tool grammar included, because Flint decides on each turn whether to reason.
+
+The grammar never names the token that ends the turn: SGLang hands XGrammar the
+model's EOS ids as stop tokens, which XGrammar allows wherever the grammar can
+end and never as grammar tokens, so ``<|observation|>`` (after tool calls),
+``<|user|>`` and end-of-text close the turn.
+
+Ported from the vendor's ``flint_sglang`` 0.1.4 kit (Apache-2.0).
+"""
+
+from __future__ import annotations
+
+from typing import Any, Dict, List, Literal, Union
+
+from transformers.tokenization_utils_base import PreTrainedTokenizerBase
+from xgrammar.builtin_structural_tag import get_model_structural_tag
+from xgrammar.structural_tag import (
+    AnyTextFormat,
+    Format,
+    OptionalFormat,
+    SequenceFormat,
+    StructuralTag,
+    TagFormat,
+    TokenFormat,
+)
+
+THINK_START = "<think>"
+THINK_END = "</think>"
+
+PROTOCOL_MARKERS = (
+    THINK_START,
+    THINK_END,
+    "<tool_call>",
+    "</tool_call>",
+    "<arg_key>",
+    "</arg_key>",
+    "<arg_value>",
+    "</arg_value>",
+    "<|begin_of_text|>",
+    "<|end_of_text|>",
+    "<|system|>",
+    "<|developer|>",
+    "<|user|>",
+    "<|assistant|>",
+    "<|observation|>",
+)
+STOP_MARKERS = ("<|end_of_text|>", "<|user|>", "<|observation|>")
+
+ToolChoiceLike = Union[Literal["auto", "required"], Dict[str, Any]]
+
+
+def build_flint_tool_grammar(
+    tools: List[Dict[str, Any]] | None = None,
+    tool_choice: ToolChoiceLike = "auto",
+    parallel_tool_calls: bool = True,
+) -> StructuralTag:
+    """The structural tag for what Flint writes after its reasoning in a turn
+    with tools.
+
+    Args:
+        tools: OpenAI-style function tool definitions (``Tool.model_dump()``).
+            Without tools the turn is plain text.
+        tool_choice: ``"auto"``, ``"required"`` or a named choice
+            (``{"type": "function", "function": {"name": ...}}``).
+        parallel_tool_calls: False allows at most one call.
+    """
+    elements: List[Format] = [AnyTextFormat(excludes=list(PROTOCOL_MARKERS))]
+    if tools:
+        # XGrammar's "required" is one or more calls; "auto" wraps them as
+        # optional after the text so a text-only answer stays legal.
+        calls_choice = "required" if tool_choice == "auto" else tool_choice
+        calls = get_model_structural_tag(
+            model="glm_4_7",
+            tools=tools,
+            tool_choice=calls_choice,
+            reasoning=False,
+            parallel_tool_calls=parallel_tool_calls,
+        ).format
+        elements.append(
+            OptionalFormat(content=calls) if tool_choice == "auto" else calls
+        )
+    return StructuralTag(format=SequenceFormat(elements=elements))
+
+
+def reasoning_then(
+    tokenizer: PreTrainedTokenizerBase, constraint: Format
+) -> StructuralTag:
+    """Flint's optional reasoning block followed by ``constraint``.
+
+    Raises:
+        ValueError: if ``<think>`` or ``</think>`` is not a dedicated token.
+    """
+    return StructuralTag(
+        format=SequenceFormat(
+            elements=[OptionalFormat(content=_reasoning(tokenizer)), constraint]
+        )
+    )
+
+
+def _reasoning(tokenizer: PreTrainedTokenizerBase) -> TagFormat:
+    return TagFormat(
+        begin=TokenFormat(token=dedicated_token_id(tokenizer, THINK_START)),
+        content=AnyTextFormat(excludes=[THINK_END, *STOP_MARKERS]),
+        end=TokenFormat(token=dedicated_token_id(tokenizer, THINK_END)),
+    )
+
+
+def dedicated_token_id(tokenizer: PreTrainedTokenizerBase, marker: str) -> int:
+    token_id = tokenizer.convert_tokens_to_ids(marker)
+    if (
+        not isinstance(token_id, int)
+        or tokenizer.convert_ids_to_tokens(token_id) != marker
+        or tokenizer.encode(marker, add_special_tokens=False) != [token_id]
+    ):
+        raise ValueError(
+            f"Flint grammar requires {marker!r} to be a dedicated vocabulary token"
+        )
+    return token_id
+
+
+__all__ = [
+    "PROTOCOL_MARKERS",
+    "STOP_MARKERS",
+    "THINK_END",
+    "THINK_START",
+    "build_flint_tool_grammar",
+    "dedicated_token_id",
+    "reasoning_then",
+]
diff --git b/python/sglang/srt/function_call/flint_detector.py b/python/sglang/srt/function_call/flint_detector.py
new file mode 100644
index 0000000..345da2e
--- /dev/null
+++ b/python/sglang/srt/function_call/flint_detector.py
@@ -0,0 +1,92 @@
+# Copyright 2023-2026 SGLang Team
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+"""Tool-call parser for Flint (``--tool-call-parser flint``).
+
+Flint writes GLM-4.7's tool-call wire format
+(``<tool_call>name<arg_key>k</arg_key><arg_value>v</arg_value></tool_call>``),
+so parsing is the GLM-4.7 detector's. What differs is the grammar: every
+request with tools (``tool_choice`` auto, required or a named function) is
+constrained by ``build_flint_tool_grammar`` (text without protocol markers,
+then the calls), and the ``flint`` grammar backend lets Flint reason before it.
+As in OpenAI's API a tool's argument schema is enforced only when the tool is
+sent with ``strict: true``; other tools keep the call format but not the schema.
+
+Ported from the vendor's ``flint_sglang`` 0.1.4 kit (Apache-2.0).
+"""
+
+from __future__ import annotations
+
+import re
+from typing import List, Literal, Optional, Union
+
+from xgrammar import StructuralTag
+
+from sglang.srt.constrained.flint_structural_tags import build_flint_tool_grammar
+from sglang.srt.entrypoints.openai.protocol import Tool, ToolChoice
+from sglang.srt.function_call.glm47_moe_detector import Glm47MoeDetector
+
+TOOL_CALL_PARSER_NAME = "flint"
+
+
+class FlintDetector(Glm47MoeDetector):
+    """GLM-4.7 wire format with Flint's turn grammar for every tool choice."""
+
+    def __init__(self) -> None:
+        super().__init__()
+        # XGrammar's tool-call tag allows whitespace after the tool name; SGLang
+        # strips it when streaming, so strip it here too before the name is
+        # used to type the arguments.
+        self.func_detail_regex = re.compile(
+            r"<tool_call>(.*?)\s*(<arg_key>.*?)?</tool_call>", re.DOTALL
+        )
+
+    def parses_required_natively(self) -> bool:
+        # Never take the GLM full-assistant EBNF path: its special tokens are
+        # GLM's, not Flint's.
+        return False
+
+    def supports_structural_tag(self) -> bool:
+        return True
+
+    def get_structural_tag_name(self) -> Optional[str]:
+        return None
+
+    def get_structural_tag(
+        self,
+        tools: Union[List[Tool], None] = None,
+        tool_choice: Union[ToolChoice, Literal["auto", "required"]] = "auto",
+        thinking_mode: bool = False,
+        parallel_tool_calls: bool = True,
+    ) -> StructuralTag:
+        # thinking_mode is deliberately ignored: the flint grammar backend puts
+        # the optional <think> block in front of this tag itself.
+        choice = (
+            tool_choice.model_dump()
+            if isinstance(tool_choice, ToolChoice)
+            else tool_choice
+        )
+        return build_flint_tool_grammar(
+            [tool.model_dump() for tool in tools or []],
+            choice,
+            parallel_tool_calls,
+        )
+
+    def get_auto_tool_call_structural_tag(
+        self,
+        tools: Union[List[Tool], None] = None,
+        thinking_mode: bool = False,
+        parallel_tool_calls: bool = True,
+    ) -> StructuralTag:
+        return self.get_structural_tag(
+            tools=tools,
+            tool_choice="auto",
+            thinking_mode=thinking_mode,
+            parallel_tool_calls=parallel_tool_calls,
+        )
+
+
+__all__ = ["TOOL_CALL_PARSER_NAME", "FlintDetector"]
