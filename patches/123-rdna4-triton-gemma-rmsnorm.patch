+# RDNA4: GemmaRMSNorm.forward_hip takes the one-launch Triton Gemma kernels without aiter
+# too. Its native fallback is ten torch launches per call (cast, pow, mean, add eps, rsqrt,
+# mul, weight cast, 1 + w, mul, cast back), 129 calls per Qwen3.5 decode step.
+# Opt-in: SGLANG_RDNA4_TRITON_GEMMA_RMSNORM=1, exported by the launch presets that passed
+# the serving gate (the fused read normalises the fp32 sum, native the bf16-rounded one).
+_use_triton_hip_gemma_rmsnorm = _is_hip and get_bool_env_var(
+    "SGLANG_RDNA4_TRITON_GEMMA_RMSNORM", "False"
+)
+_triton_hip_gemma_rmsnorm_noted = False
 
