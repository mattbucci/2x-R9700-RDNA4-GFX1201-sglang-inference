             return self.forward_native(x)
 
 
+def _note_triton_hip_gemma_rmsnorm() -> None:
+    global _triton_hip_gemma_rmsnorm_noted
+    if not _triton_hip_gemma_rmsnorm_noted:
+        _triton_hip_gemma_rmsnorm_noted = True
+        logger.info("[RDNA4] Gemma RMSNorm: one-launch Triton kernel active")
+
+
 class GemmaRMSNorm(BaseFusedOp):
