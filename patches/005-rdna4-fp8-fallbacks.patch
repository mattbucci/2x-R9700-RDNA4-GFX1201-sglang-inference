+def _w8a8_block_fp8_matmul_torch(
+    A: torch.Tensor,
+    B: torch.Tensor,
+    As: torch.Tensor,
+    Bs: torch.Tensor,
+    block_size: List[int],
+    output_dtype: torch.dtype = torch.bfloat16,
+) -> torch.Tensor:
+    """RDNA4 fallback: dequantize FP8 to BF16 and use torch.mm.
+    Avoids Triton FP8 matmul ISA that generates invalid gfx1201 instructions.
+    A can be BF16 (from linear layer) or FP8 (from MoE)."""
+    block_n, block_k = block_size
+    M = A.shape[0]
+    K = A.shape[1]
+    N = B.shape[0]
+
+    # Dequantize A: [M, K] -> bf16, apply per-token-group scales if present
+    A_bf16 = A.to(output_dtype)
+    if As is not None and As.numel() > 1:
+        As_expanded = As.repeat_interleave(block_k, dim=-1)[:, :K]
+        A_bf16 = A_bf16 * As_expanded.to(output_dtype)
+    elif As is not None:
+        A_bf16 = A_bf16 * As.to(output_dtype)
+
+    # Dequantize B: [N, K] fp8 -> bf16, apply block scales
+    B_bf16 = B.to(output_dtype)
+    if Bs is not None and Bs.numel() > 1:
+        Bs_expanded = Bs.repeat_interleave(block_n, dim=0).repeat_interleave(block_k, dim=1)
+        Bs_expanded = Bs_expanded[:N, :K]
+        B_bf16 = B_bf16 * Bs_expanded.to(output_dtype)
+    elif Bs is not None:
+        B_bf16 = B_bf16 * Bs.to(output_dtype)
+
+    # Standard matmul: [M, K] @ [K, N] -> [M, N]
+    return torch.mm(A_bf16, B_bf16.t()).to(output_dtype)
+
