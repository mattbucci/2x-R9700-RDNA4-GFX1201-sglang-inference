+++ b/python/sglang/kernels/ops/attention/verify_splitkv.py
@@ -61,6 +61,17 @@ _BLOCK_CONFIG = {
 }
 
 
+def _min_row_tile(device) -> int:
+    """Minimum L_EXT dot tile: 16 on RDNA (WMMA 16x16x16), 1 elsewhere."""
+    if not _IS_HIP:
+        return 1
+    try:
+        arch = torch.cuda.get_device_properties(device).gcnArchName
+    except Exception:
+        return 1
+    return 16 if arch.startswith(("gfx11", "gfx12")) else 1
+
+
 def block_config(head_dim):
     """Return (BLOCK_N, num_warps) for a head_dim; default for untuned dims."""
     return _BLOCK_CONFIG.get(head_dim, (DEFAULT_BLOCK_N, DEFAULT_NUM_WARPS))
@@ -448,7 +459,11 @@ class VerifySplitKV:
         self.head_dim = head_dim
         self.v_head_dim = v_head_dim
         self.l_ext = l_ext  # real draft tokens per seq (fixed == 4)
-        self.l_pad = triton.next_power_of_2(l_ext)
+        # RDNA (gfx11/gfx12) WMMA needs >=16-row dot tiles: Triton's AMD
+        # optimize-dot-operands pass fails ("PassManager::run failed") for
+        # L_EXT in {2,4,8} on gfx1201. Rows >= l_ext are masked on every load
+        # and store, so padding the tile to 16 changes nothing but the shape.
+        self.l_pad = max(_min_row_tile(device), triton.next_power_of_2(l_ext))
         self.device = device
         self.n_splits = n_splits
         self.block_n = block_n
