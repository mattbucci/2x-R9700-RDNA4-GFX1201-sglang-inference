+// Tokens adds a completed request's token usage to the per-backend, per-model
+// counters and counts the request for the pair (ADR-0011). Zero counts add no series;
+// a request that reached no backend is not counted.
+func (m *Metrics) Tokens(backend, model string, prompt, completion, reasoning int) {
+	if backend == "" {
+		return
+	}
+	m.send(metricOp{kind: opTokens, backend: backend, model: model, prompt: prompt, completion: completion, reasoning: reasoning})
+}
+
+// Usage returns the per-backend, per-model accounting, sorted by backend then model.
+func (m *Metrics) Usage() []UsageRow {
+	reply := make(chan []UsageRow, 1)
+	select {
+	case m.ops <- metricOp{kind: opUsage, usage: reply}:
+		return <-reply
+	case <-time.After(2 * time.Second):
+		return []UsageRow{}
+	}
+}
+
