diff -ruN base/internal/server/tokencount.go ref2/internal/server/tokencount.go
--- a/internal/server/tokencount.go	1969-12-31 16:00:00.000000000 -0800
+++ b/internal/server/tokencount.go	2026-11-27 19:36:06.389459717 -0800
@@ -0,0 +1,87 @@
+package server
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+
+	"github.com/mattbucci/simple-llm-router/internal/model"
+)
+
+// countRequest is the subset of a chat request the estimator reads.
+type countRequest struct {
+	Model    string          `json:"model"`
+	System   json.RawMessage `json:"system"`
+	Messages []struct {
+		Content json.RawMessage `json:"content"`
+	} `json:"messages"`
+}
+
+// textBytes returns the UTF-8 byte length of the text in a content value: a JSON
+// string, or an array of blocks whose "text" blocks are counted.
+func textBytes(raw json.RawMessage) int {
+	var str string
+	if json.Unmarshal(raw, &str) == nil {
+		return len(str)
+	}
+	var blocks []struct {
+		Type string `json:"type"`
+		Text string `json:"text"`
+	}
+	n := 0
+	if json.Unmarshal(raw, &blocks) == nil {
+		for _, b := range blocks {
+			if b.Type == "text" {
+				n += len(b.Text)
+			}
+		}
+	}
+	return n
+}
+
+// estimateTokens is the local estimate: one token per four bytes of text,
+// rounded up, never below one.
+func estimateTokens(req *countRequest) int {
+	n := textBytes(req.System)
+	for _, m := range req.Messages {
+		n += textBytes(m.Content)
+	}
+	if t := (n + 3) / 4; t > 1 {
+		return t
+	}
+	return 1
+}
+
+func (s *Server) decodeCount(w http.ResponseWriter, r *http.Request, consumer model.Protocol) *countRequest {
+	body, err := io.ReadAll(http.MaxBytesReader(w, r.Body, s.maxBodySize))
+	if err != nil {
+		writeAPIErrorFor(w, consumer, bodyReadError(err))
+		return nil
+	}
+	var req countRequest
+	if err := json.Unmarshal(body, &req); err != nil {
+		writeAPIErrorFor(w, consumer, model.ErrBadRequest("request body is not valid JSON"))
+		return nil
+	}
+	if req.Model == "" {
+		writeAPIErrorFor(w, consumer, model.ErrBadRequest("model is required"))
+		return nil
+	}
+	return &req
+}
+
+func (s *Server) handleCountTokensAnthropic(w http.ResponseWriter, r *http.Request) {
+	if req := s.decodeCount(w, r, model.ProtocolAnthropic); req != nil {
+		writeJSON(w, http.StatusOK, map[string]any{"input_tokens": estimateTokens(req)})
+	}
+}
+
+func (s *Server) handleCountTokensOpenAI(w http.ResponseWriter, r *http.Request) {
+	if req := s.decodeCount(w, r, model.ProtocolOpenAI); req != nil {
+		writeJSON(w, http.StatusOK, map[string]any{"object": "token_count", "model": req.Model, "input_tokens": estimateTokens(req)})
+	}
+}
+
+func (s *Server) handleUsage(w http.ResponseWriter, r *http.Request) {
+	writeJSON(w, http.StatusOK, map[string]any{"object": "list", "data": s.metrics.Usage()})
+}
diff -ruN base/internal/server/tokencount_test.go ref2/internal/server/tokencount_test.go
--- a/internal/server/tokencount_test.go	1969-12-31 16:00:00.000000000 -0800
+++ b/internal/server/tokencount_test.go	2026-11-27 19:38:14.330423258 -0800
@@ -0,0 +1,65 @@
+package server_test
+
+import (
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/mattbucci/simple-llm-router/internal/router"
+)
+
+func tokenReq(t *testing.T, h http.Handler, method, path, body, token string) (int, string) {
+	t.Helper()
+	req := httptest.NewRequest(method, path, strings.NewReader(body))
+	req.Header.Set("Content-Type", "application/json")
+	if token != "" {
+		req.Header.Set("Authorization", "Bearer "+token)
+	}
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, req)
+	return rec.Code, strings.TrimSpace(rec.Body.String())
+}
+
+func TestCountTokensEndpoints(t *testing.T) {
+	h := newServer(t, map[string]router.Backend{}, map[string]*router.Alias{}, snapshot(), nil, io.Discard).Handler()
+	cases := []struct {
+		path, body string
+		status     int
+		want       string
+	}{
+		{"/v1/messages/count_tokens", `{"model":"m","messages":[{"role":"user","content":"abcdefghij"}]}`, 200, `{"input_tokens":3}`},
+		{"/v1/messages/count_tokens", `{"model":"m","system":[{"type":"text","text":"abcd"}],"messages":[{"role":"user","content":[{"type":"text","text":"efgh"},{"type":"image"}]}]}`, 200, `{"input_tokens":2}`},
+		{"/v1/messages/count_tokens", `{"model":"m","messages":[]}`, 200, `{"input_tokens":1}`},
+		{"/v1/tokens/count", `{"model":"m","messages":[{"role":"user","content":"abcde"}]}`, 200, `{"input_tokens":2,"model":"m","object":"token_count"}`},
+		{"/v1/tokens/count", `{"messages":[]}`, 400, ""},
+		{"/v1/messages/count_tokens", `{not json`, 400, ""},
+	}
+	for _, c := range cases {
+		status, body := tokenReq(t, h, "POST", c.path, c.body, "")
+		if status != c.status || (c.want != "" && body != c.want) {
+			t.Errorf("%s %s: got %d %s, want %d %s", c.path, c.body, status, body, c.status, c.want)
+		}
+	}
+}
+
+func TestUsageEndpointAndAuth(t *testing.T) {
+	h := newServer(t, map[string]router.Backend{}, map[string]*router.Alias{}, snapshot(), nil, io.Discard).Handler()
+	if status, body := tokenReq(t, h, "GET", "/v1/usage", "", ""); status != 200 || body != `{"data":[],"object":"list"}` {
+		t.Errorf("empty usage: %d %s", status, body)
+	}
+	authed := newServer(t, map[string]router.Backend{}, map[string]*router.Alias{}, snapshot(), []string{"tok"}, io.Discard).Handler()
+	for _, p := range []string{"/v1/usage", "/v1/tokens/count", "/v1/messages/count_tokens"} {
+		method := "POST"
+		if p == "/v1/usage" {
+			method = "GET"
+		}
+		if status, _ := tokenReq(t, authed, method, p, `{"model":"m","messages":[]}`, ""); status != 401 {
+			t.Errorf("%s without a token: %d, want 401", p, status)
+		}
+		if status, _ := tokenReq(t, authed, method, p, `{"model":"m","messages":[]}`, "tok"); status != 200 {
+			t.Errorf("%s with a token: %d, want 200", p, status)
+		}
+	}
+}
