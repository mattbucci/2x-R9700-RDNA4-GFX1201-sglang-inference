@@ -0,0 +1,25 @@
+package observability
+
+import (
+	"context"
+	"strings"
+	"testing"
+)
+
+func TestTokensTotal(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	m := New(ctx)
+	m.Tokens("a", "m", 3, 2, 0)
+	m.Tokens("a", "m", 4, 1, 5)
+	out := m.Render()
+	for _, want := range []string{
+		`llmrouter_tokens_total{backend="a",model="m",type="prompt"} 7`,
+		`llmrouter_tokens_total{backend="a",model="m",type="completion"} 3`,
+		`llmrouter_tokens_total{backend="a",model="m",type="reasoning"} 5`,
+	} {
+		if !strings.Contains(out, want) {
+			t.Fatalf("missing %q in\n%s", want, out)
+		}
+	}
+}
