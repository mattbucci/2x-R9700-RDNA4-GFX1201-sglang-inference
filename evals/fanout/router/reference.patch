+// Tokens adds a completed request's token usage to the per-backend, per-model
+// counters (ADR-0011). Zero counts add nothing.
+func (m *Metrics) Tokens(backend, model string, prompt, completion, reasoning int) {
+	if prompt <= 0 && completion <= 0 && reasoning <= 0 {
+		return
+	}
+	m.send(metricOp{kind: opTokens, backend: backend, model: model, prompt: prompt, completion: completion, reasoning: reasoning})
+}
+
